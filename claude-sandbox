# Config files are parsed, never sourced: `cs .` in an untrusted repo must not
# be able to execute code on the host.
readonly CONFIG_KEYS="AUTO_GIT AUTO_GIT_INTERVAL BROWSER UPDATE_TOOLS NETWORK PULL_POLICY IMAGE_REF"

load_config_file() {
    local file="$1"
    [[ -f "$file" ]] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" != *=* ]] && continue

        key="${line%%=*}"
        value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"

        # Allowlist keys and reject anything that isn't a plain scalar
        [[ " $CONFIG_KEYS " == *" $key "* ]] || continue
        [[ "$value" =~ ^[A-Za-z0-9._:/@-]*$ ]] || continue

        printf -v "$key" '%s' "$value"
    done < "$file"
}

