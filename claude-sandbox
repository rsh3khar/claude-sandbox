        else
            if [[ -n "$GH_USER" ]]; then
                draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}GitHub${NC}        ${C_ACCENT}@${GH_USER}${NC}"
            else
                draw_box_row $w "  ${C_ERROR}${DOT}${NC} ${C_DIM}GitHub${NC}        ${C_TEXT}Not connected${NC}"
            fi

            if [[ -n "$SELECTED_REPO" ]]; then
                draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Repository${NC}    ${C_TEXT}${SELECTED_REPO}${NC}"
            else
                draw_box_row $w "  ${C_DIM}${RING}${NC} ${C_DIM}Repository${NC}    ${C_DIM}None selected${NC}"
            fi
        fi

        local running
        running=$(list_sandbox_ids | wc -l | tr -d ' ')
        draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Network${NC}       ${C_TEXT}${NETWORK}${NC}"
        draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Running${NC}       ${C_TEXT}${running} sandbox(es)${NC}"
        draw_spacer $w
        draw_box_bottom $w

        echo ""

        local options=()
        if [[ "$LOCAL_MODE" == true ]]; then
            [[ -n "$SELECTED_REPO" ]] && options+=("🚀  Launch Sandbox")
            options+=("📂  Select Directory")
            options+=("🔄  Switch to GitHub")
        else
            [[ -n "$SELECTED_REPO" && -n "$GH_USER" ]] && options+=("🚀  Launch Sandbox")
            options+=("📂  Select Repository")
            options+=("🔄  Switch to Local")
            options+=("👤  Switch Account")
        fi
        [[ "$running" -gt 0 ]] && options+=("📋  Running Sandboxes")
        options+=("🔧  Rebuild Image")
        options+=("❌  Exit")

        local choice
        choice=$(printf '%s\n' "${options[@]}" | gum choose --height=10)

        case "$choice" in
            "🚀  Launch Sandbox")
                if screen_launch_confirm; then
                    launch_sandbox
                    echo -e "  ${C_DIM}Press Enter to continue...${NC}"
                    read -r
                fi
                ;;
            "📂  Select Repository") screen_repo_select ;;
            "📂  Select Directory")  screen_local_path ;;
            "🔄  Switch to GitHub")
                LOCAL_MODE=false
                LOCAL_PATH=""; SELECTED_REPO=""; SELECTED_REPO_URL=""; EXTRA_PATHS=()
                [[ -z "$GH_USER" ]] && refresh_gh_user
                ;;
            "🔄  Switch to Local")
                LOCAL_MODE=true
                SELECTED_REPO=""; SELECTED_REPO_URL=""; EXTRA_PATHS=()
                screen_local_path
                ;;
            "👤  Switch Account") screen_switch_account ;;
            "📋  Running Sandboxes")
                echo ""
                cmd_ps
                echo ""
                echo -e "  ${C_DIM}Press Enter to continue...${NC}"
                read -r
                ;;
            "🔧  Rebuild Image")
                echo ""
                echo -e "  ${C_ACCENT}${BULLET}${NC} ${C_TEXT}Rebuilding sandbox image (no cache)...${NC}"
                can_build_locally || die "No Dockerfile in ${SCRIPT_DIR} — install with --link for dev mode"
                build_image --no-cache
                echo ""
                echo -e "  ${C_DIM}Press Enter to continue...${NC}"
                read -r
                ;;
            "❌  Exit")
                clear
                echo ""
                echo -e "  ${C_DIM}Goodbye.${NC}"
                echo ""
                exit 0
                ;;
        esac
    done
}

screen_switch_account() {
    local w=56

    clear
    echo ""
    draw_mini_logo
    echo ""

    local accounts
    accounts=$(get_all_accounts)

    if [[ -z "$accounts" ]]; then
        say_warn "No accounts found"
        echo ""
        echo -e "  ${C_DIM}Run ${C_TEXT}gh auth login${C_DIM} to add an account${NC}"
        echo ""
        read -r
        return
    fi

    draw_box $w "SWITCH ACCOUNT"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Select a GitHub account:${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    local selected
    selected=$(printf '%s\n+ Add new account\n' "$accounts" | gum choose --height=6)

