refresh_gh_user() {
    local tmpfile
    tmpfile=$(mktemp)
    # Expanding $tmpfile now is deliberate: it is a local that will be gone by
    # the time RETURN fires.
    # shellcheck disable=SC2064
    trap "rm -f '$tmpfile'" RETURN

    (
        if gh auth status &>/dev/null; then
            local user
            user=$(gh api user 2>/dev/null || echo "")
            if [[ -n "$user" ]]; then
                echo "$user" > "$tmpfile"
            fi
        fi
    ) &
    animate_spinner $! "Connecting to GitHub..."

    if [[ -s "$tmpfile" ]]; then
        GH_USER_DATA=$(cat "$tmpfile")
        GH_USER=$(echo "$GH_USER_DATA" | jq -r '.login // ""')
    else
        GH_USER=""
        GH_USER_DATA=""
    fi
}

get_all_accounts() {
    gh auth status 2>&1 | grep -o 'account [^ ]*' | awk '{print $2}' || true
}

draw_contribution_graph() {
    local username="$1"

    local query='query($username: String!) {
        user(login: $username) {
            contributionsCollection {
                contributionCalendar {
                    totalContributions
                    weeks {
                        contributionDays {
                            contributionCount
                            date
                        }
                    }
                }
            }
        }
    }'

    local data
    data=$(gh api graphql -f query="$query" -f username="$username" 2>/dev/null || echo "")

    [[ -z "$data" ]] && return 0

    local total
    total=$(echo "$data" | jq -r '.data.user.contributionsCollection.contributionCalendar.totalContributions // 0')

    # Render the last 26 weeks in one jq pass (was 182 subprocess calls)
    local blocks
    blocks=$(echo "$data" | jq -r '
        .data.user.contributionsCollection.contributionCalendar.weeks[-26:]
        | map(.contributionDays | map(.contributionCount))
        | .[] | @tsv' 2>/dev/null)

    [[ -z "$blocks" ]] && return 0

    local graph_lines=("" "" "" "" "" "" "")
    local week counts day_idx count block
    while IFS= read -r week; do
        IFS=$'\t' read -r -a counts <<< "$week"
        for day_idx in 0 1 2 3 4 5 6; do
            count="${counts[$day_idx]:-0}"
            if [[ "$count" -eq 0 ]]; then
                block="${C_DIM}░${NC}"
            elif [[ "$count" -le 3 ]]; then
                block=$'\033[38;2;22;101;52m▒'"${NC}"
            elif [[ "$count" -le 6 ]]; then
                block=$'\033[38;2;34;139;34m▓'"${NC}"
            else
                block=$'\033[38;2;0;200;83m█'"${NC}"
            fi
            graph_lines[day_idx]+="$block"
        done
    done <<< "$blocks"

    echo ""
    echo -e "  ${C_DIM}${total} contributions this year${NC}"
    echo ""
    echo -e "  ${C_DIM}M${NC} ${graph_lines[1]}"
    echo -e "  ${C_DIM}W${NC} ${graph_lines[3]}"
    echo -e "  ${C_DIM}F${NC} ${graph_lines[5]}"
    echo ""
    echo -e "  ${C_DIM}░${NC}${C_DIM} none${NC}  \033[38;2;22;101;52m▒${NC}${C_DIM} low${NC}  \033[38;2;34;139;34m▓${NC}${C_DIM} med${NC}  \033[38;2;0;200;83m█${NC}${C_DIM} high${NC}"
}

draw_user_card() {
    local username="$1"
    local w=56

    [[ -z "$GH_USER_DATA" ]] && return 0

    local name followers public_repos total_private_repos
    name=$(echo "$GH_USER_DATA" | jq -r '.name // .login')
    followers=$(echo "$GH_USER_DATA" | jq -r '.followers // 0')
    public_repos=$(echo "$GH_USER_DATA" | jq -r '.public_repos // 0')
    total_private_repos=$(echo "$GH_USER_DATA" | jq -r '.total_private_repos // .owned_private_repos // 0')

    local contrib_tmpfile
    contrib_tmpfile=$(mktemp)

    (draw_contribution_graph "$username" > "$contrib_tmpfile" 2>/dev/null) &
    local contrib_pid=$!

    local private_repos="$total_private_repos"
    if [[ "$private_repos" == "0" || "$private_repos" == "null" ]]; then
        local priv_tmpfile
        priv_tmpfile=$(mktemp)
        (gh repo list --limit 10000 --json isPrivate --jq '[.[] | select(.isPrivate == true)] | length' 2>/dev/null > "$priv_tmpfile" || echo "0" > "$priv_tmpfile") &
        local priv_pid=$!
        animate_spinner $priv_pid "Loading profile..."
        private_repos=$(cat "$priv_tmpfile" 2>/dev/null || echo "0")
        rm -f "$priv_tmpfile"
    fi

    echo ""
    draw_box $w "GITHUB"
    draw_spacer $w
    draw_box_row $w "${C_BRIGHT}${BOLD}  ◉ ${name}${NC}"
    draw_box_row $w "${C_DIM}    @${username}${NC}"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  ${BULLET} ${public_repos} public  ${BULLET} ${private_repos} private  ${BULLET} ${followers} followers${NC}"
    draw_box_bottom $w

    if kill -0 "$contrib_pid" 2>/dev/null; then
        animate_spinner $contrib_pid "Loading contributions..."
    fi
    wait "$contrib_pid" 2>/dev/null || true
    cat "$contrib_tmpfile"
    rm -f "$contrib_tmpfile"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Local Paths & Extra Mounts                                              │
# └─────────────────────────────────────────────────────────────────────────┘

# EXTRA_PATHS entries are "abs_path|mount_name|mode". Pipe-separated because
# absolute paths may legitimately contain a colon.
mount_path() { local e="$1"; echo "${e%%|*}"; }
mount_name() { local e="${1#*|}"; echo "${e%%|*}"; }
mount_mode() { local e="$1"; echo "${e##*|}"; }

# Walk up to the repository root, so `cs .` works from any subdirectory.
git_root_of() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

# Expand ~, resolve to an absolute path
abs_path_of() {
    local p="${1/#\~/$HOME}"
    (cd "$p" 2>/dev/null && pwd)
}

# Resolve a unique mount name, appending -2, -3, etc. on collision
resolve_mount_name() {
    local base="$1"
    local name="$base"
    local suffix=2
    local primary
    primary=$(basename "${SELECTED_REPO:-}")

    while true; do
        local collision=false
        if [[ "$name" == "$primary" ]]; then
            collision=true
        fi
        if [[ "$collision" == false ]]; then
            for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
                if [[ "$name" == "$(mount_name "$ep")" ]]; then
                    collision=true
                    break
                fi
            done
        fi
        [[ "$collision" == false ]] && break
        name="${base}-${suffix}"
        ((suffix++))
    done

    echo "$name"
}

# Add a mount. Accepts "path", "path:ro", or "path:name" forms.
# Non-git directories are allowed — plenty of useful mounts are just notes,
# data, or design assets.
validate_and_add_extra_path() {
    local spec="$1"
    local mode="rw" raw_path="$spec"

    if [[ "$spec" == *:ro ]]; then
        mode="ro"
        raw_path="${spec%:ro}"
    elif [[ "$spec" == *:rw ]]; then
        raw_path="${spec%:rw}"
    fi

    local abs
    abs=$(abs_path_of "$raw_path") || {
        say_err "Directory not found: ${raw_path}"
        return 1
    }

    # Mount the repo root, not a subdirectory of it
    local root
    root=$(git_root_of "$abs") && [[ -n "$root" ]] && abs="$root"

    if [[ "$abs" == "$LOCAL_PATH" ]]; then
        say_warn "Already the primary repo: ${abs}"
        return 1
    fi
    for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
        if [[ "$abs" == "$(mount_path "$ep")" ]]; then
            say_warn "Already added: ${abs}"
            return 1
        fi
    done

    local name
    name=$(resolve_mount_name "$(basename "$abs")")
    EXTRA_PATHS+=("${abs}|${name}|${mode}")

    local note=""
    [[ "$mode" == "ro" ]] && note=" ${C_DIM}[read-only]${NC}"
    [[ -e "$abs/.git" ]] || note+=" ${C_DIM}(not a git repo)${NC}"
    say_ok "Added: ${C_ACCENT}${name}${NC} ${C_DIM}(${abs})${NC}${note}"
    return 0
}

# MOUNTS=../api,../web:ro  in a .claude-sandbox file. Relative paths resolve
# against the repo the config came from.
add_mounts_from_config() {
    local base_dir="$1"
    [[ -n "${MOUNTS:-}" ]] || return 0

    local spec resolved
    local IFS_SAVE="$IFS"
    IFS=','
    for spec in $MOUNTS; do
        IFS="$IFS_SAVE"
        spec="${spec#"${spec%%[![:space:]]*}"}"
        spec="${spec%"${spec##*[![:space:]]}"}"
        [[ -z "$spec" ]] && continue

        resolved="$spec"
        if [[ "$spec" != /* && "$spec" != ~* ]]; then
            resolved="${base_dir}/${spec}"
        fi
        validate_and_add_extra_path "$resolved" >/dev/null 2>&1 \
            && say_ok "Mounted from config: ${C_ACCENT}$(basename "${spec%%:*}")${NC}" \
            || say_warn "Config mount skipped: ${spec}"
        IFS=','
    done
    IFS="$IFS_SAVE"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Recent Workspaces                                                       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Local sessions are the common case, and re-typing the same set of mounts
# every time is the main friction. Remember them.

RECENT_FILE="${CLAUDE_SANDBOX_RECENT:-$HOME/.config/claude-sandbox/recent}"
readonly RECENT_MAX=10

remember_workspace() {
    [[ "$LOCAL_MODE" == true && -n "$LOCAL_PATH" ]] || return 0

    # Tab-separated, not comma: a mount path may legitimately contain a comma
    # (e.g. ~/Clients/Acme, Inc/api) and would otherwise be split in two.
    local extras=""
    for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
        extras+="${extras:+$'\t'}$(mount_path "$ep")"
        [[ "$(mount_mode "$ep")" == "ro" ]] && extras+=":ro"
    done

    mkdir -p "$(dirname "$RECENT_FILE")" 2>/dev/null || return 0
    local entry="${LOCAL_PATH}	${extras}"
    local tmp
    tmp=$(mktemp) || return 0
    # Every branch must succeed: a missing recent file (first ever launch) or a
    # grep that matches nothing would otherwise fail the pipeline under set -e
    # and abort the launch.
    {
        printf '%s\n' "$entry"
        if [[ -f "$RECENT_FILE" ]]; then
            grep -vF "${LOCAL_PATH}	" "$RECENT_FILE" 2>/dev/null || true
        fi
    } > "$tmp".all || true
    head -n "$RECENT_MAX" "$tmp".all > "$tmp" 2>/dev/null || true
    rm -f "$tmp".all
    mv "$tmp" "$RECENT_FILE" 2>/dev/null || rm -f "$tmp"
    return 0
}

# Emit "label<TAB>path<TAB>extras" for each still-existing recent workspace
list_recent_workspaces() {
    [[ -f "$RECENT_FILE" ]] || return 0

    local line path extras label count
    while IFS= read -r line; do
        path="${line%%$'\t'*}"
        extras=""
        [[ "$line" == *$'\t'* ]] && extras="${line#*$'\t'}"

        [[ -n "$path" && -d "$path" ]] || continue
        label="$(basename "$path")"
        if [[ -n "$extras" ]]; then
            count=$(awk -F'\t' '{print NF}' <<< "$extras")
            label+=" + ${count} mount(s)"
        fi
        printf '%s\t%s\t%s\n' "$label" "$path" "$extras"
    done < "$RECENT_FILE"
}

restore_recent_workspace() {
    local path="$1" extras="$2"

    LOCAL_MODE=true
    LOCAL_PATH="$path"
    SELECTED_REPO=$(basename "$path")
    EXTRA_PATHS=()

    # Tab-delimited; read -r keeps spaces and commas in paths intact.
    # The `|| [[ -n "$spec" ]]` matters: the input has no trailing newline, so
    # a plain `read` would silently drop the last mount.
    local spec
    while IFS= read -r spec || [[ -n "$spec" ]]; do
        [[ -n "$spec" ]] && validate_and_add_extra_path "$spec" >/dev/null 2>&1
    done < <(printf '%s' "$extras" | tr '\t' '\n')
}

