# Ensure terminal is restored on exit. The trap is installed only when this
# file is executed, not sourced — an EXIT trap set at source time would
# clobber the caller's own (bats, for one, reports results from its EXIT trap).
cleanup_terminal() {
    # Only emit terminal control sequences to a real terminal. When stdout is a
    # pipe — `cs exec ... > file`, `cs . --dry-run | grep` — these would end up
    # in the captured output and corrupt it.
    [[ -t 1 ]] || return 0
    tput cnorm 2>/dev/null || true  # Show cursor
    stty echo 2>/dev/null || true   # Enable echo
}

