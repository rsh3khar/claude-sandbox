        "Search my repos")
            echo ""

            local repos
            repos=$(gum spin --spinner dot --title "Loading repositories..." --show-output -- \
                gh repo list --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' 2>/dev/null)

            if [[ -z "$repos" ]]; then
                echo -e "  ${C_ERROR}${CROSS}${NC} No repositories found"
                sleep 1
                return
            fi

            echo ""
            local selected
            selected=$(echo "$repos" | gum filter --placeholder="Search repos..." --height=12)

            if [[ -n "$selected" ]]; then
                confirm_repo "$selected"
            fi
            ;;

        "Enter repo name")
            echo ""
            local name
            name=$(gum input --placeholder="owner/repo")

            if [[ -n "$name" ]]; then
                echo ""
                local url
                url=$(gum spin --spinner dot --title "Looking up ${name}..." --show-output -- \
                    gh repo view "$name" --json sshUrl --jq '.sshUrl' 2>/dev/null || echo "")

                if [[ -n "$url" ]]; then
                    confirm_repo "$name"
                else
                    echo -e "  ${C_ERROR}${CROSS}${NC} Repository not found"
                    sleep 1
                fi
            fi
            ;;

        "Paste URL")
            echo ""
            local url
            url=$(gum input --placeholder="git@github.com:user/repo.git")

            if [[ -n "$url" ]]; then
                SELECTED_REPO=$(basename "$url" .git)
                SELECTED_REPO_URL="$url"
            fi
            ;;
    esac
}

confirm_repo() {
    local repo="$1"
    local w=56

    clear
    echo ""
    draw_mini_logo
    echo ""

    # Fetch repo details
    local info
    info=$(gh repo view "$repo" --json name,owner,description,stargazerCount,forkCount,primaryLanguage,pushedAt 2>/dev/null || echo "")

    if [[ -z "$info" ]]; then
        echo -e "  ${C_ERROR}${CROSS}${NC} Could not fetch repository info"
        sleep 1
        return
    fi

    local name owner desc stars forks lang pushed
    name=$(echo "$info" | jq -r '.name // ""')
    owner=$(echo "$info" | jq -r '.owner.login // ""')
    desc=$(echo "$info" | jq -r '.description // ""' | head -c 45)
    stars=$(echo "$info" | jq -r '.stargazerCount // 0')
    forks=$(echo "$info" | jq -r '.forkCount // 0')
    lang=$(echo "$info" | jq -r '.primaryLanguage.name // "—"')
    pushed=$(echo "$info" | jq -r '.pushedAt // ""')

    if [[ -n "$pushed" ]]; then
        pushed=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$pushed" "+%b %d" 2>/dev/null || echo "")
    fi

    draw_box $w "REPOSITORY"
    draw_spacer $w
    draw_box_row $w "${C_BRIGHT}${BOLD}  ${owner}/${name}${NC}"
    if [[ -n "$desc" ]]; then
        draw_box_row $w "${C_DIM}  ${desc}${NC}"
    fi
    draw_spacer $w
    draw_separator $w
    draw_spacer $w
    draw_box_row $w "  ${C_WARN}★${NC} ${stars}    ${C_DIM}⑂${NC} ${forks}    ${C_BLUE}◆${NC} ${lang}    ${C_DIM}⟳${NC} ${pushed}"
    draw_spacer $w
    draw_box_bottom $w

    echo ""

    if gum confirm "Use this repository?"; then
        SELECTED_REPO="$repo"
        SELECTED_REPO_URL=$(gh repo view "$repo" --json sshUrl --jq '.sshUrl' 2>/dev/null)
    fi
}

