# Portable ISO-8601 -> "Mon DD". GNU date and BSD date disagree on flags.
format_date() {
    local iso="${1:-}"
    [[ -z "$iso" || "$iso" == "null" ]] && return 0
    date -d "$iso" "+%b %d" 2>/dev/null \
        || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$iso" "+%b %d" 2>/dev/null \
        || true
}

# Slugify a string for use in container names
slugify() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's#[^a-z0-9._-]#-#g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//'
}

animate_spinner() {
    local pid=$1
    local msg="${2:-Loading}"
    local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local i=0

    trap 'tput cnorm 2>/dev/null' RETURN

    tput civis 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  %s%s%s %s%s%s  " "$C_ACCENT" "${frames[$i]}" "$NC" "$C_DIM" "$msg" "$NC"
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.08
    done
    printf "\r%50s\r" ""
    tput cnorm 2>/dev/null || true
}

