# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Launch Logic                                                            │
# └─────────────────────────────────────────────────────────────────────────┘

ensure_image() {
    local inspect_result
    inspect_result=$(mktemp)
    (docker image inspect "$IMAGE_NAME" &>/dev/null && echo "exists" > "$inspect_result" || true) &
    animate_spinner $! "Checking image..."

    if [[ "$(cat "$inspect_result" 2>/dev/null)" != "exists" ]]; then
        rm -f "$inspect_result"
        echo ""
        echo -e "  ${C_ACCENT}${BULLET}${NC} ${C_TEXT}Building sandbox image...${NC}"
        echo ""
        docker build -t "$IMAGE_NAME" "$SCRIPT_DIR" 2>&1 | while read -r line; do
            echo -e "    ${C_DIM}${line}${NC}"
        done
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Image ready"
    else
        rm -f "$inspect_result"
    fi
}

launch_sandbox() {
    clear
    echo ""
    draw_mini_logo
    echo ""

    echo -e "  ${C_ACCENT}▸${NC} Preparing sandbox..."
    ensure_image

    echo -e "  ${C_ACCENT}▸${NC} Launching container..."
    echo ""

    # SSH agent forwarding - detect socket location
    local ssh_args=()
    if [[ -S "/run/host-services/ssh-auth.sock" ]]; then
        # Docker Desktop on macOS
        ssh_args=(
            "-v" "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
            "-e" "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"
        )
    elif [[ -n "$SSH_AUTH_SOCK" && -S "$SSH_AUTH_SOCK" ]]; then
        # OrbStack / native macOS agent - mount the actual socket
        ssh_args=(
            "-v" "$SSH_AUTH_SOCK:/tmp/ssh-agent.sock"
            "-e" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock"
        )
    fi

    # Git identity from host
    local git_name git_email
    git_name=$(git config --global user.name 2>/dev/null || echo "")
    git_email=$(git config --global user.email 2>/dev/null || echo "")

    # Auth for Claude (read from secure file or env)
    local auth_args=()
    local oauth_token="${CLAUDE_CODE_OAUTH_TOKEN:-}"

    # Try reading from secure file if env not set
    if [[ -z "$oauth_token" && -f "$HOME/.claude-sandbox-token" ]]; then
        oauth_token=$(cat "$HOME/.claude-sandbox-token" 2>/dev/null | tr -d '\n')
    fi

    if [[ -n "$oauth_token" ]]; then
        auth_args+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$oauth_token")
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Using OAuth token"
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        auth_args+=("-e" "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Using API key"
    else
        echo -e "  ${C_WARN}${BULLET}${NC} ${C_DIM}No auth - run 'claude setup-token' and save to ~/.claude-sandbox-token${NC}"
    fi

    # Optional host config mounts (AWS, gh CLI)
    local extra_mounts=()

    # Resolve GitHub token in background
    local gh_tmpfile
    gh_tmpfile=$(mktemp)

    (gh auth token 2>/dev/null > "$gh_tmpfile" || true) &
    local gh_pid=$!

    # Claude config (should always exist, but guard anyway)
    if [[ -d "$HOME/.claude" ]]; then
        extra_mounts+=("-v" "$HOME/.claude:/home/node/.claude")
    fi

    # SSH keys for git operations
    if [[ -d "$HOME/.ssh" ]]; then
        extra_mounts+=("-v" "$HOME/.ssh:/home/node/.ssh-host:ro")
    fi

    # AWS: bind-mount ~/.aws so container always sees host's current credentials.
    # No static credential export — env vars go stale in long-running containers.
    # The SDK reads directly from the mounted config/SSO cache, so when the host
    # refreshes (aws sso login), the container picks it up immediately.
    if [[ -d "$HOME/.aws" ]]; then
        extra_mounts+=("-v" "$HOME/.aws:/home/node/.aws")
        # Validate that current session is active
        if aws sts get-caller-identity &>/dev/null; then
            echo -e "  ${C_SUCCESS}${CHECK}${NC} AWS credentials mounted (live session)"
        else
            echo -e "  ${C_WARN}${BULLET}${NC} ${C_DIM}AWS config mounted (no active session — run ${C_TEXT}aws sso login${C_DIM} on host)${NC}"
        fi
    fi
    # Forward AWS_PROFILE / AWS_DEFAULT_REGION if set on host
    [[ -n "${AWS_PROFILE:-}" ]] && auth_args+=("-e" "AWS_PROFILE=$AWS_PROFILE")
    [[ -n "${AWS_DEFAULT_REGION:-}" ]] && auth_args+=("-e" "AWS_DEFAULT_REGION=$AWS_DEFAULT_REGION")
    [[ -n "${AWS_REGION:-}" ]] && auth_args+=("-e" "AWS_REGION=$AWS_REGION")

    animate_spinner $gh_pid "Forwarding credentials..."

    # GitHub CLI: mount config for settings, then extract token from keyring
    if [[ -d "$HOME/.config/gh" ]]; then
        extra_mounts+=("-v" "$HOME/.config/gh:/home/node/.config/gh:ro")
    fi

    # Codex CLI config (only if exists)
    if [[ -d "$HOME/.codex" ]]; then
        extra_mounts+=("-v" "$HOME/.codex:/home/node/.codex")
    fi
    local gh_token
    gh_token=$(cat "$gh_tmpfile" 2>/dev/null | tr -d '\n' || echo "")
    rm -f "$gh_tmpfile"
    if [[ -n "$gh_token" ]]; then
        auth_args+=("-e" "GH_TOKEN=$gh_token")
        echo -e "  ${C_SUCCESS}${CHECK}${NC} GitHub CLI token forwarded"
    elif [[ -d "$HOME/.config/gh" ]]; then
        echo -e "  ${C_WARN}${BULLET}${NC} ${C_DIM}GitHub config mounted (token in keyring not accessible — run ${C_TEXT}gh auth login${C_DIM})${NC}"
    fi

    # Auto-git toggle
    local auto_git_args=()
    if [[ "$AUTO_GIT" == false ]]; then
        auto_git_args+=("-e" "DISABLE_AUTO_GIT=1")
        echo -e "  ${C_WARN}${BULLET}${NC} Auto-save disabled"
    else
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Auto-save enabled"
    fi

    if [[ "$LOCAL_MODE" == true ]]; then
        # Local mode: bind mount the repo, pass --local flag
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Local mode: mounting ${LOCAL_PATH}"

        # Build extra repo mount args
        local extra_repo_mounts=()
        for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
            local ep_path="${ep%%:*}"
            local ep_name="${ep##*:}"
            extra_repo_mounts+=("-v" "$ep_path:/home/node/workspace/$ep_name")
            echo -e "  ${C_SUCCESS}${CHECK}${NC} Extra mount: ${ep_name}"
        done

        docker run --rm -it --init \
            --network host \
            -e "TERM=${TERM:-xterm-256color}" \
            -e "CLAUDE_SANDBOX=1" \
            -e "LOCAL_MODE=1" \
            -v "$LOCAL_PATH:/home/node/workspace/$SELECTED_REPO" \
            ${extra_repo_mounts[@]+"${extra_repo_mounts[@]}"} \
            -e "GIT_USER_NAME=$git_name" \
            -e "GIT_USER_EMAIL=$git_email" \
            "${auth_args[@]}" \
            "${ssh_args[@]}" \
            "${extra_mounts[@]}" \
            "${auto_git_args[@]}" \
            "$IMAGE_NAME" \
            "--local" "$SELECTED_REPO"

        # After exit (local mode)
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} ${C_TEXT}Container destroyed${NC}"
        echo -e "  ${C_DIM}  Your changes are on a local branch${NC}"
        echo ""
    else
        # GitHub mode: clone from URL
        docker run --rm -it --init \
            --network host \
            -e "TERM=${TERM:-xterm-256color}" \
            -e "CLAUDE_SANDBOX=1" \
            -e "GIT_USER_NAME=$git_name" \
            -e "GIT_USER_EMAIL=$git_email" \
            "${auth_args[@]}" \
            "${ssh_args[@]}" \
            "${extra_mounts[@]}" \
            "${auto_git_args[@]}" \
            "$IMAGE_NAME" \
            "$SELECTED_REPO_URL"

        # After exit (GitHub mode)
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} ${C_TEXT}Container destroyed${NC}"
        echo -e "  ${C_DIM}  Your changes are safely on GitHub${NC}"
        echo ""
    fi

    echo -e "  ${C_DIM}Press Enter to continue...${NC}"
    read -r
}

