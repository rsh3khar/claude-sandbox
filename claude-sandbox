# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Argument Parsing                                                        │
# └─────────────────────────────────────────────────────────────────────────┘

POSITIONAL=()

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)        ASSUME_YES=true; shift ;;
            -b|--branch)     SANDBOX_BRANCH="${2:?--branch needs a value}"; shift 2 ;;
            -m|--mount)      POSITIONAL+=("${2:?--mount needs a path}"); shift 2 ;;
            -n|--name)       CONTAINER_NAME="${2:?--name needs a value}"; shift 2 ;;
            --auto-git)      AUTO_GIT=true; shift ;;
            --no-auto-git)   AUTO_GIT=false; shift ;;
            --interval)      AUTO_GIT_INTERVAL="${2:?--interval needs a value}"; shift 2 ;;
            --browser)       BROWSER=true; shift ;;
            --no-browser)    BROWSER=false; shift ;;
            --update-tools)  UPDATE_TOOLS=true; shift ;;
            --network)       NETWORK="${2:?--network needs a value}"; shift 2 ;;
            -p|--publish)    PUBLISH_PORTS+=("${2:?--publish needs a value}"); NETWORK="bridge"; shift 2 ;;
            --image)         IMAGE_REF="${2:?--image needs a value}"; shift 2 ;;
            --pull)          PULL_POLICY="always"; shift ;;
            --no-pull)       PULL_POLICY="never"; shift ;;
            --dry-run)       DRY_RUN=true; ASSUME_YES=true; shift ;;
            -h|--help)       show_help; exit 0 ;;
            -v|--version)    echo "claude-sandbox ${VERSION}"; exit 0 ;;
            --)              shift; POSITIONAL+=("$@"); break ;;
            -*)              die "Unknown option: $1  (try: claude-sandbox --help)" ;;
            *)               POSITIONAL+=("$1"); shift ;;
        esac
    done
}

# Set up SELECTED_REPO / LOCAL_MODE from a target argument
resolve_target() {
    local input="$1"

    if [[ "$input" == "." || "$input" == ".." || "$input" == /* || "$input" == ~* || -d "$input" ]]; then
        LOCAL_MODE=true
        input="${input/#\~/$HOME}"
        LOCAL_PATH=$(cd "$input" 2>/dev/null && pwd) || die "Directory not found: ${input}"
        [[ -e "$LOCAL_PATH/.git" ]] || die "Not a git repository: ${LOCAL_PATH}"

        SELECTED_REPO=$(basename "$LOCAL_PATH")
        load_config_file "$LOCAL_PATH/$REPO_CONFIG_FILE"
        [[ "$DRY_RUN" == true ]] || say_ok "Local repo: ${C_ACCENT}${SELECTED_REPO}${NC}"
        return 0
    fi

    LOCAL_MODE=false
    if [[ "$input" == http* || "$input" == git@* ]]; then
        SELECTED_REPO_URL="$input"
        SELECTED_REPO=$(basename "$input" .git)
    else
        SELECTED_REPO_URL=$(gh repo view "$input" --json sshUrl --jq '.sshUrl' 2>/dev/null || echo "")
        SELECTED_REPO="$input"
        [[ -n "$SELECTED_REPO_URL" ]] || die "Repository not found: ${input}"
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Entry Point                                                             │
# └─────────────────────────────────────────────────────────────────────────┘

main() {
    load_config_file "$CONFIG_FILE"

    # Dispatch management subcommands before generic parsing
    case "${1:-}" in
        ps)      shift; check_deps; cmd_ps "$@"; exit 0 ;;
        attach)  shift; check_deps; cmd_attach "${1:-}"; exit 0 ;;
        kill)    shift; check_deps; parse_args "$@"; cmd_kill "${POSITIONAL[0]:-${1:-}}"; exit 0 ;;
        orphans) shift; check_deps; cmd_orphans; exit 0 ;;
        doctor)  shift; cmd_doctor; exit 0 ;;
        update)  shift; check_deps; parse_args "$@"; cmd_update; exit 0 ;;
        version) echo "claude-sandbox ${VERSION}"; exit 0 ;;
        help)    show_help; exit 0 ;;
        run)     shift ;;
    esac

    parse_args "$@"
    set -- ${POSITIONAL[@]+"${POSITIONAL[@]}"}

    check_deps

    # Direct invocation with a target
    if [[ $# -gt 0 ]]; then
        resolve_target "$1"
        shift

        EXTRA_PATHS=()
        for extra_arg in "$@"; do
            validate_and_add_extra_path "$extra_arg" \
                || say_err "Skipping invalid extra path: ${extra_arg}"
        done

        if [[ "$DRY_RUN" == true ]]; then
            launch_sandbox
            exit 0
        fi

        if screen_launch_confirm; then
            launch_sandbox
        fi
        exit 0
    fi

    # Interactive mode
    screen_welcome
    detect_current_repo

    if [[ -z "$SELECTED_REPO" ]]; then
        screen_source_select
    fi

    screen_main_menu
}

# Only run when executed, so tests can source this file
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    trap cleanup_terminal EXIT INT TERM
    main "$@"
fi
