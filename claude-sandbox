refresh_gh_user() {
    local tmpfile
    tmpfile=$(mktemp)
    trap "rm -f '$tmpfile'" RETURN

    # Run API calls in background so we can show a spinner
    (
        if gh auth status &>/dev/null; then
            local user
            user=$(gh api user 2>/dev/null || echo "")
            if [[ -n "$user" ]]; then
                echo "$user" > "$tmpfile"
            fi
        fi
    ) &
    animate_spinner $! "Connecting to GitHub..."

    if [[ -s "$tmpfile" ]]; then
        GH_USER_DATA=$(cat "$tmpfile")
        GH_USER=$(echo "$GH_USER_DATA" | jq -r '.login // ""')
    else
        GH_USER=""
        GH_USER_DATA=""
    fi
}

get_all_accounts() {
    gh auth status 2>&1 | grep -o 'account [^ ]*' | awk '{print $2}' || true
}

draw_contribution_graph() {
    local username="$1"

    local query='query($username: String!) {
        user(login: $username) {
            contributionsCollection {
                contributionCalendar {
                    totalContributions
                    weeks {
                        contributionDays {
                            contributionCount
                            date
                        }
                    }
                }
            }
        }
    }'

    local data
    data=$(gh api graphql -f query="$query" -f username="$username" 2>/dev/null || echo "")

    if [[ -z "$data" ]]; then
        return
    fi

    local total
    total=$(echo "$data" | jq -r '.data.user.contributionsCollection.contributionCalendar.totalContributions // 0')

    # Get last 26 weeks
    local weeks
    weeks=$(echo "$data" | jq -r '.data.user.contributionsCollection.contributionCalendar.weeks[-26:]')

    # Build contribution map
    local graph_lines=("" "" "" "" "" "" "")

    for week_idx in $(seq 0 25); do
        for day_idx in $(seq 0 6); do
            local count
            count=$(echo "$weeks" | jq -r ".[$week_idx].contributionDays[$day_idx].contributionCount // 0" 2>/dev/null || echo "0")

            local block
            if [[ "$count" -eq 0 ]]; then
                block="${C_DIM}░${NC}"
            elif [[ "$count" -le 3 ]]; then
                block="\033[38;2;22;101;52m▒${NC}"
            elif [[ "$count" -le 6 ]]; then
                block="\033[38;2;34;139;34m▓${NC}"
            else
                block="\033[38;2;0;200;83m█${NC}"
            fi

            graph_lines[$day_idx]+="$block"
        done
    done

    echo ""
    echo -e "  ${C_DIM}${total} contributions this year${NC}"
    echo ""
    echo -e "  ${C_DIM}M${NC} ${graph_lines[1]}"
    echo -e "  ${C_DIM}W${NC} ${graph_lines[3]}"
    echo -e "  ${C_DIM}F${NC} ${graph_lines[5]}"
    echo ""
    echo -e "  ${C_DIM}░${NC}${C_DIM} none${NC}  \033[38;2;22;101;52m▒${NC}${C_DIM} low${NC}  \033[38;2;34;139;34m▓${NC}${C_DIM} med${NC}  \033[38;2;0;200;83m█${NC}${C_DIM} high${NC}"
}

draw_user_card() {
    local username="$1"
    local w=56

    if [[ -z "$GH_USER_DATA" ]]; then
        return
    fi

    local name followers public_repos
    name=$(echo "$GH_USER_DATA" | jq -r '.name // .login')
    followers=$(echo "$GH_USER_DATA" | jq -r '.followers // 0')
    public_repos=$(echo "$GH_USER_DATA" | jq -r '.public_repos // 0')
    local total_private_repos
    total_private_repos=$(echo "$GH_USER_DATA" | jq -r '.total_private_repos // .owned_private_repos // 0')

    # Fetch private repo count + contribution graph in parallel (background)
    local contrib_tmpfile
    contrib_tmpfile=$(mktemp)

    (draw_contribution_graph "$username" > "$contrib_tmpfile" 2>/dev/null) &
    local contrib_pid=$!

    # If API didn't give us private count, fetch it (slow path)
    local private_repos="$total_private_repos"
    if [[ "$private_repos" == "0" || "$private_repos" == "null" ]]; then
        local priv_tmpfile
        priv_tmpfile=$(mktemp)
        (gh repo list --limit 10000 --json isPrivate --jq '[.[] | select(.isPrivate == true)] | length' 2>/dev/null > "$priv_tmpfile" || echo "0" > "$priv_tmpfile") &
        local priv_pid=$!
        animate_spinner $priv_pid "Loading profile..."
        private_repos=$(cat "$priv_tmpfile" 2>/dev/null || echo "0")
        rm -f "$priv_tmpfile"
    fi

    echo ""
    draw_box $w "GITHUB"
    draw_spacer $w
    draw_box_row $w "${C_BRIGHT}${BOLD}  ◉ ${name}${NC}"
    draw_box_row $w "${C_DIM}    @${username}${NC}"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  ${BULLET} ${public_repos} public  ${BULLET} ${private_repos} private  ${BULLET} ${followers} followers${NC}"
    draw_box_bottom $w

    # Wait for contribution graph to finish
    if kill -0 "$contrib_pid" 2>/dev/null; then
        animate_spinner $contrib_pid "Loading contributions..."
    fi
    wait "$contrib_pid" 2>/dev/null
    cat "$contrib_tmpfile"
    rm -f "$contrib_tmpfile"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Extra Mount Helpers                                                     │
# └─────────────────────────────────────────────────────────────────────────┘

# Resolve a unique mount name, appending -2, -3, etc. on collision
resolve_mount_name() {
    local base="$1"
    local name="$base"
    local suffix=2

    # Check against primary repo
    while true; do
        local collision=false
        if [[ "$name" == "$SELECTED_REPO" ]]; then
            collision=true
        fi
        # Check against already-added extras (stored as path:mount_name pairs)
        if [[ "$collision" == false ]]; then
            for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
                local existing_name="${ep##*:}"
                if [[ "$name" == "$existing_name" ]]; then
                    collision=true
                    break
                fi
            done
        fi
        if [[ "$collision" == false ]]; then
            break
        fi
        name="${base}-${suffix}"
        ((suffix++))
    done

    echo "$name"
}

# Validate a path and add it to EXTRA_PATHS. Returns 0 on success, 1 on failure.
validate_and_add_extra_path() {
    local raw_path="$1"

    # Expand ~ and resolve
    raw_path="${raw_path/#\~/$HOME}"
    local abs_path
    abs_path=$(cd "$raw_path" 2>/dev/null && pwd) || {
        echo -e "  ${C_ERROR}${CROSS}${NC} Directory not found: ${raw_path}"
        return 1
    }

    if [[ ! -d "$abs_path/.git" ]]; then
        echo -e "  ${C_ERROR}${CROSS}${NC} Not a git repository: ${abs_path}"
        return 1
    fi

    # Don't allow duplicates or mounting the primary path again
    if [[ "$abs_path" == "$LOCAL_PATH" ]]; then
        echo -e "  ${C_WARN}${BULLET}${NC} Already the primary repo: ${abs_path}"
        return 1
    fi
    for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
        local existing_path="${ep%%:*}"
        if [[ "$abs_path" == "$existing_path" ]]; then
            echo -e "  ${C_WARN}${BULLET}${NC} Already added: ${abs_path}"
            return 1
        fi
    done

    local mount_name
    mount_name=$(resolve_mount_name "$(basename "$abs_path")")
    EXTRA_PATHS+=("${abs_path}:${mount_name}")

    echo -e "  ${C_SUCCESS}${CHECK}${NC} Added: ${C_ACCENT}${mount_name}${NC} ${C_DIM}(${abs_path})${NC}"
    return 0
}

