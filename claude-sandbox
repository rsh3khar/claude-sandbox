ensure_image() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        echo ""
        echo -e "  ${C_ACCENT}${BULLET}${NC} ${C_TEXT}Building sandbox image...${NC}"
        echo ""
        docker build -t "$IMAGE_NAME" "$SCRIPT_DIR" 2>&1 | while read -r line; do
            echo -e "    ${C_DIM}${line}${NC}"
        done
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Image ready"
    fi
}

launch_sandbox() {
    clear
    echo ""
    draw_mini_logo
    echo ""

    echo -e "  ${C_ACCENT}▸${NC} Preparing sandbox..."
    ensure_image

    echo -e "  ${C_ACCENT}▸${NC} Launching container..."
    echo ""

    # SSH agent forwarding for OrbStack/Docker Desktop
    local ssh_args=(
        "-v" "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
        "-e" "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"
    )

    # Git identity from host
    local git_name git_email
    git_name=$(git config --global user.name 2>/dev/null || echo "")
    git_email=$(git config --global user.email 2>/dev/null || echo "")

    # Auth for Claude (read from secure file or env)
    local auth_args=()
    local oauth_token="${CLAUDE_CODE_OAUTH_TOKEN:-}"

    # Try reading from secure file if env not set
    if [[ -z "$oauth_token" && -f "$HOME/.claude-sandbox-token" ]]; then
        oauth_token=$(cat "$HOME/.claude-sandbox-token" 2>/dev/null | tr -d '\n')
    fi

    if [[ -n "$oauth_token" ]]; then
        auth_args+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$oauth_token")
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Using OAuth token"
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        auth_args+=("-e" "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Using API key"
    else
        echo -e "  ${C_WARN}${BULLET}${NC} ${C_DIM}No auth - run 'claude setup-token' and save to ~/.claude-sandbox-token${NC}"
    fi

    if [[ "$LOCAL_MODE" == true ]]; then
        # Local mode: bind mount the repo, pass --local flag
        echo -e "  ${C_SUCCESS}${CHECK}${NC} Local mode: mounting ${LOCAL_PATH}"

        docker run --rm -it --init \
            --network host \
            -e "TERM=${TERM:-xterm-256color}" \
            -e "CLAUDE_SANDBOX=1" \
            -e "LOCAL_MODE=1" \
            -v "$HOME/.claude:/home/node/.claude" \
            -v "$HOME/.ssh:/home/node/.ssh-host:ro" \
            -v "$LOCAL_PATH:/home/node/workspace/$SELECTED_REPO" \
            -e "GIT_USER_NAME=$git_name" \
            -e "GIT_USER_EMAIL=$git_email" \
            "${auth_args[@]}" \
            "${ssh_args[@]}" \
            "$IMAGE_NAME" \
            "--local" "$SELECTED_REPO"

        # After exit (local mode)
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} ${C_TEXT}Container destroyed${NC}"
        echo -e "  ${C_DIM}  Your changes are on a local branch${NC}"
        echo ""
    else
        # GitHub mode: clone from URL
        docker run --rm -it --init \
            --network host \
            -e "TERM=${TERM:-xterm-256color}" \
            -e "CLAUDE_SANDBOX=1" \
            -v "$HOME/.claude:/home/node/.claude" \
            -v "$HOME/.ssh:/home/node/.ssh-host:ro" \
            -e "GIT_USER_NAME=$git_name" \
            -e "GIT_USER_EMAIL=$git_email" \
            "${auth_args[@]}" \
            "${ssh_args[@]}" \
            "$IMAGE_NAME" \
            "$SELECTED_REPO_URL"

        # After exit (GitHub mode)
        echo ""
        echo -e "  ${C_SUCCESS}${CHECK}${NC} ${C_TEXT}Container destroyed${NC}"
        echo -e "  ${C_DIM}  Your changes are safely on GitHub${NC}"
        echo ""
    fi

    echo -e "  ${C_DIM}Press Enter to continue...${NC}"
    read -r
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Main Menu                                                               │
# └─────────────────────────────────────────────────────────────────────────┘

screen_main_menu() {
    local w=56

    while true; do
        clear
        echo ""
        draw_mini_logo
        echo ""

        # Status card
        draw_box $w "STATUS"
        draw_spacer $w

        if [[ "$LOCAL_MODE" == true ]]; then
            draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Mode${NC}          ${C_ACCENT}Local${NC}"
            if [[ -n "$SELECTED_REPO" ]]; then
                draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Repository${NC}    ${C_TEXT}${SELECTED_REPO}${NC}"
                draw_box_row $w "  ${C_DIM}  ${NC} ${C_DIM}Path${NC}          ${C_DIM}${LOCAL_PATH}${NC}"
            else
                draw_box_row $w "  ${C_DIM}${RING}${NC} ${C_DIM}Repository${NC}    ${C_DIM}None selected${NC}"
            fi
        else
            if [[ -n "$GH_USER" ]]; then
                draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}GitHub${NC}        ${C_ACCENT}@${GH_USER}${NC}"
            else
                draw_box_row $w "  ${C_ERROR}${DOT}${NC} ${C_DIM}GitHub${NC}        ${C_TEXT}Not connected${NC}"
            fi

            if [[ -n "$SELECTED_REPO" ]]; then
                draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Repository${NC}    ${C_TEXT}${SELECTED_REPO}${NC}"
            else
                draw_box_row $w "  ${C_DIM}${RING}${NC} ${C_DIM}Repository${NC}    ${C_DIM}None selected${NC}"
            fi
        fi

        draw_box_row $w "  ${C_SUCCESS}${DOT}${NC} ${C_DIM}Network${NC}       ${C_TEXT}host mode${NC}"
        draw_spacer $w
        draw_box_bottom $w

        echo ""

        # Build menu options
        local options=()

        if [[ "$LOCAL_MODE" == true ]]; then
            if [[ -n "$SELECTED_REPO" ]]; then
                options+=("🚀  Launch Sandbox")
            fi
            options+=("📂  Select Directory")
            options+=("🔄  Switch to GitHub")
            options+=("❌  Exit")
        else
            if [[ -n "$SELECTED_REPO" && -n "$GH_USER" ]]; then
                options+=("🚀  Launch Sandbox")
            fi
            options+=("📂  Select Repository")
            options+=("🔄  Switch to Local")
            options+=("👤  Switch Account")
            options+=("❌  Exit")
        fi

        local choice
        choice=$(printf '%s\n' "${options[@]}" | gum choose --height=8)

        case "$choice" in
            "🚀  Launch Sandbox")
                if screen_launch_confirm; then
                    launch_sandbox
                fi
                ;;
            "📂  Select Repository")
                screen_repo_select
                ;;
            "📂  Select Directory")
                screen_local_path
                ;;
            "🔄  Switch to GitHub")
                LOCAL_MODE=false
                LOCAL_PATH=""
                SELECTED_REPO=""
                SELECTED_REPO_URL=""
                ;;
            "🔄  Switch to Local")
                LOCAL_MODE=true
                SELECTED_REPO=""
                SELECTED_REPO_URL=""
                screen_local_path
                ;;
            "👤  Switch Account")
                screen_switch_account
                ;;
            "❌  Exit")
                clear
                echo ""
                echo -e "  ${C_DIM}Goodbye.${NC}"
                echo ""
                exit 0
                ;;
        esac
    done
}

screen_switch_account() {
    local w=56

    clear
    echo ""
    draw_mini_logo
    echo ""

    local accounts
    accounts=$(get_all_accounts)

    if [[ -z "$accounts" ]]; then
        echo -e "  ${C_WARN}${BULLET}${NC} No accounts found"
        echo ""
        echo -e "  ${C_DIM}Run ${C_TEXT}gh auth login${C_DIM} to add an account${NC}"
        echo ""
        read -r
        return
    fi

    draw_box $w "SWITCH ACCOUNT"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Select a GitHub account:${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    accounts=$(echo -e "${accounts}\n+ Add new account")

    local selected
    selected=$(echo "$accounts" | gum choose --height=6)

    if [[ "$selected" == "+ Add new account" ]]; then
        gh auth login
    elif [[ -n "$selected" ]]; then
        gh auth switch --user "$selected" 2>/dev/null || true
    fi

    refresh_gh_user

    if [[ -n "$GH_USER" ]]; then
        clear
        echo ""
        draw_mini_logo
        echo ""
        draw_user_card "$GH_USER"
        echo ""
        echo -e "  ${C_DIM}Press Enter to continue...${NC}"
        read -r
    fi
}


# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Current Directory Detection                                             │
# └─────────────────────────────────────────────────────────────────────────┘

detect_current_repo() {
    if ! git rev-parse --git-dir &>/dev/null; then
        return
    fi

    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ -z "$remote_url" ]]; then
        return
    fi

    # Extract owner/repo
    local repo_path
    if [[ "$remote_url" == git@* ]]; then
        repo_path=$(echo "$remote_url" | sed 's/.*://' | sed 's/\.git$//')
    else
        repo_path=$(echo "$remote_url" | sed -E 's|https?://[^/]+/||' | sed 's/\.git$//')
    fi

    local w=56
    clear
    echo ""
    draw_mini_logo
    echo ""

    draw_box $w "CURRENT DIRECTORY"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Detected git repository:${NC}"
    draw_box_row $w "${C_BRIGHT}  ${repo_path}${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    if gum confirm "Use this repository?"; then
        SELECTED_REPO="$repo_path"
        SELECTED_REPO_URL="$remote_url"
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Dependencies Check                                                      │
# └─────────────────────────────────────────────────────────────────────────┘

check_deps() {
    local missing=()
    command -v docker &>/dev/null || missing+=("docker")
    command -v gh &>/dev/null || missing+=("gh")
    command -v gum &>/dev/null || missing+=("gum")
    command -v jq &>/dev/null || missing+=("jq")

    if [[ ${#missing[@]} -gt 0 ]]; then
        clear
        echo ""
        draw_logo
        echo ""
        echo -e "  ${C_ERROR}${CROSS}${NC} ${C_TEXT}Missing dependencies:${NC}"
        echo ""
        for dep in "${missing[@]}"; do
            echo -e "    ${C_DIM}•${NC} ${dep}"
        done
        echo ""
        echo -e "  ${C_DIM}Install with: ${C_TEXT}brew install ${missing[*]}${NC}"
        echo ""
        exit 1
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Entry Point                                                             │
# └─────────────────────────────────────────────────────────────────────────┘

main() {
    # Direct invocation with args
    if [[ $# -gt 0 ]]; then
        check_deps

        local input="$1"

        # Check if it's a local path (starts with . / ~ or is an existing directory)
        if [[ "$input" == "." || "$input" == ".." || "$input" == /* || "$input" == ~* || -d "$input" ]]; then
            # Local mode
            LOCAL_MODE=true

            # Expand ~ and resolve to absolute path
            input="${input/#\~/$HOME}"
            LOCAL_PATH=$(cd "$input" 2>/dev/null && pwd) || {
                echo -e "  ${C_ERROR}${CROSS}${NC} Directory not found: ${input}"
                exit 1
            }

            # Check if it's a git repo
            if [[ ! -d "$LOCAL_PATH/.git" ]]; then
                echo -e "  ${C_ERROR}${CROSS}${NC} Not a git repository: ${LOCAL_PATH}"
                exit 1
            fi

            SELECTED_REPO=$(basename "$LOCAL_PATH")
            echo -e "  ${C_SUCCESS}${CHECK}${NC} Local repo: ${C_ACCENT}${SELECTED_REPO}${NC}"

            if screen_launch_confirm; then
                launch_sandbox
            fi
            exit 0
        fi

        # GitHub mode
        refresh_gh_user

        if [[ "$input" == http* || "$input" == git@* ]]; then
            SELECTED_REPO_URL="$input"
            SELECTED_REPO=$(basename "$input" .git)
        else
            SELECTED_REPO_URL=$(gh repo view "$input" --json sshUrl --jq '.sshUrl' 2>/dev/null || echo "")
            SELECTED_REPO="$input"

            if [[ -z "$SELECTED_REPO_URL" ]]; then
                echo -e "  ${C_ERROR}${CROSS}${NC} Repository not found: ${input}"
                exit 1
            fi
        fi

        if screen_launch_confirm; then
            launch_sandbox
        fi
        exit 0
    fi

    # Interactive mode
    check_deps
    screen_welcome
    detect_current_repo

    # If no repo detected from current dir, show source selection
    if [[ -z "$SELECTED_REPO" ]]; then
        screen_source_select
    fi

    screen_main_menu
}

main "$@"
