# Config files are parsed, never sourced: `cs .` in an untrusted repo must not
# be able to execute code on the host.
readonly CONFIG_KEYS="AUTO_GIT AUTO_GIT_INTERVAL BROWSER UPDATE_TOOLS NETWORK PULL_POLICY IMAGE_REF WORKTREE AGENT MOUNTS SNAPSHOT"

# Options set explicitly on the command line always beat config files, which
# are loaded later (a repo's .claude-sandbox is only found after the target is
# resolved).
EXPLICIT_KEYS=()
mark_explicit() { EXPLICIT_KEYS+=("$1"); }
is_explicit() {
    local k
    for k in ${EXPLICIT_KEYS[@]+"${EXPLICIT_KEYS[@]}"}; do
        [[ "$k" == "$1" ]] && return 0
    done
    return 1
}

load_config_file() {
    local file="$1"
    [[ -f "$file" ]] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" != *=* ]] && continue

        key="${line%%=*}"
        value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"

        # Allowlist keys and reject anything that isn't a plain scalar.
        # Commas, ~ and spaces are allowed for MOUNTS; no shell metacharacters.
        [[ " $CONFIG_KEYS " == *" $key "* ]] || continue
        [[ "$value" =~ ^[A-Za-z0-9._:/@,~\ -]*$ ]] || continue
        is_explicit "$key" && continue

        printf -v "$key" '%s' "$value"
        mark_explicit "$key"
    done < "$file"
}

