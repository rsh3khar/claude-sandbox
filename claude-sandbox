# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Current Directory Detection                                             │
# └─────────────────────────────────────────────────────────────────────────┘

detect_current_repo() {
    if ! git rev-parse --git-dir &>/dev/null; then
        return
    fi

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || return)

    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    # Extract display name (owner/repo if remote exists, else just dirname)
    local display_name
    if [[ -n "$remote_url" ]]; then
        if [[ "$remote_url" == git@* ]]; then
            display_name=$(echo "$remote_url" | sed 's/.*://' | sed 's/\.git$//')
        else
            display_name=$(echo "$remote_url" | sed -E 's|https?://[^/]+/||' | sed 's/\.git$//')
        fi
    else
        display_name=$(basename "$repo_root")
    fi

    local w=56
    clear
    echo ""
    draw_mini_logo
    echo ""

    draw_box $w "CURRENT DIRECTORY"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Detected git repository:${NC}"
    draw_box_row $w "${C_BRIGHT}  ${display_name}${NC}"
    draw_box_row $w "${C_DIM}  ${repo_root}${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    if gum confirm "Use this repository?"; then
        LOCAL_MODE=true
        LOCAL_PATH="$repo_root"
        SELECTED_REPO=$(basename "$repo_root")
        EXTRA_PATHS=()

        # Offer to mount additional directories
        while true; do
            echo ""
            if ! gum confirm "Mount additional directories?"; then
                break
            fi

            local extra_input
            extra_input=$(gum input --placeholder="Path to another git repo...")

            if [[ -z "$extra_input" ]]; then
                break
            fi

            validate_and_add_extra_path "$extra_input" || sleep 1
        done
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Dependencies Check                                                      │
# └─────────────────────────────────────────────────────────────────────────┘

check_deps() {
    local missing=()
    command -v docker &>/dev/null || missing+=("docker")
    command -v gh &>/dev/null || missing+=("gh")
    command -v gum &>/dev/null || missing+=("gum")
    command -v jq &>/dev/null || missing+=("jq")

    if [[ ${#missing[@]} -gt 0 ]]; then
        clear
        echo ""
        draw_logo
        echo ""
        echo -e "  ${C_ERROR}${CROSS}${NC} ${C_TEXT}Missing dependencies:${NC}"
        echo ""
        for dep in "${missing[@]}"; do
            echo -e "    ${C_DIM}•${NC} ${dep}"
        done
        echo ""
        echo -e "  ${C_DIM}Install with: ${C_TEXT}brew install ${missing[*]}${NC}"
        echo ""
        exit 1
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Entry Point                                                             │
# └─────────────────────────────────────────────────────────────────────────┘

main() {
    # Direct invocation with args
    if [[ $# -gt 0 ]]; then
        check_deps

        local input="$1"

        # Check if it's a local path (starts with . / ~ or is an existing directory)
        if [[ "$input" == "." || "$input" == ".." || "$input" == /* || "$input" == ~* || -d "$input" ]]; then
            # Local mode
            LOCAL_MODE=true

            # Expand ~ and resolve to absolute path
            input="${input/#\~/$HOME}"
            LOCAL_PATH=$(cd "$input" 2>/dev/null && pwd) || {
                echo -e "  ${C_ERROR}${CROSS}${NC} Directory not found: ${input}"
                exit 1
            }

            # Check if it's a git repo
            if [[ ! -d "$LOCAL_PATH/.git" ]]; then
                echo -e "  ${C_ERROR}${CROSS}${NC} Not a git repository: ${LOCAL_PATH}"
                exit 1
            fi

            SELECTED_REPO=$(basename "$LOCAL_PATH")
            echo -e "  ${C_SUCCESS}${CHECK}${NC} Local repo: ${C_ACCENT}${SELECTED_REPO}${NC}"

            # Process remaining args as extra mounts
            shift
            EXTRA_PATHS=()
            for extra_arg in "$@"; do
                validate_and_add_extra_path "$extra_arg" || {
                    echo -e "  ${C_ERROR}${CROSS}${NC} Skipping invalid extra path: ${extra_arg}"
                }
            done

            if screen_launch_confirm; then
                launch_sandbox
            fi
            exit 0
        fi

        # GitHub mode
        refresh_gh_user

        if [[ "$input" == http* || "$input" == git@* ]]; then
            SELECTED_REPO_URL="$input"
            SELECTED_REPO=$(basename "$input" .git)
        else
            SELECTED_REPO_URL=$(gh repo view "$input" --json sshUrl --jq '.sshUrl' 2>/dev/null || echo "")
            SELECTED_REPO="$input"

            if [[ -z "$SELECTED_REPO_URL" ]]; then
                echo -e "  ${C_ERROR}${CROSS}${NC} Repository not found: ${input}"
                exit 1
            fi
        fi

        if screen_launch_confirm; then
            launch_sandbox
        fi
        exit 0
    fi

    # Interactive mode
    check_deps
    screen_welcome
    detect_current_repo

    # If no repo detected from current dir, show source selection
    if [[ -z "$SELECTED_REPO" ]]; then
        screen_source_select
    fi

    screen_main_menu
}

main "$@"
