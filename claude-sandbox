refresh_gh_user() {
    local tmpfile
    tmpfile=$(mktemp)
    # Expanding $tmpfile now is deliberate: it is a local that will be gone by
    # the time RETURN fires.
    # shellcheck disable=SC2064
    trap "rm -f '$tmpfile'" RETURN

    (
        if gh auth status &>/dev/null; then
            local user
            user=$(gh api user 2>/dev/null || echo "")
            if [[ -n "$user" ]]; then
                echo "$user" > "$tmpfile"
            fi
        fi
    ) &
    animate_spinner $! "Connecting to GitHub..."

    if [[ -s "$tmpfile" ]]; then
        GH_USER_DATA=$(cat "$tmpfile")
        GH_USER=$(echo "$GH_USER_DATA" | jq -r '.login // ""')
    else
        GH_USER=""
        GH_USER_DATA=""
    fi
}

get_all_accounts() {
    gh auth status 2>&1 | grep -o 'account [^ ]*' | awk '{print $2}' || true
}

draw_contribution_graph() {
    local username="$1"

    local query='query($username: String!) {
        user(login: $username) {
            contributionsCollection {
                contributionCalendar {
                    totalContributions
                    weeks {
                        contributionDays {
                            contributionCount
                            date
                        }
                    }
                }
            }
        }
    }'

    local data
    data=$(gh api graphql -f query="$query" -f username="$username" 2>/dev/null || echo "")

    [[ -z "$data" ]] && return 0

    local total
    total=$(echo "$data" | jq -r '.data.user.contributionsCollection.contributionCalendar.totalContributions // 0')

    # Render the last 26 weeks in one jq pass (was 182 subprocess calls)
    local blocks
    blocks=$(echo "$data" | jq -r '
        .data.user.contributionsCollection.contributionCalendar.weeks[-26:]
        | map(.contributionDays | map(.contributionCount))
        | .[] | @tsv' 2>/dev/null)

    [[ -z "$blocks" ]] && return 0

    local graph_lines=("" "" "" "" "" "" "")
    local week counts day_idx count block
    while IFS= read -r week; do
        IFS=$'\t' read -r -a counts <<< "$week"
        for day_idx in 0 1 2 3 4 5 6; do
            count="${counts[$day_idx]:-0}"
            if [[ "$count" -eq 0 ]]; then
                block="${C_DIM}░${NC}"
            elif [[ "$count" -le 3 ]]; then
                block=$'\033[38;2;22;101;52m▒'"${NC}"
            elif [[ "$count" -le 6 ]]; then
                block=$'\033[38;2;34;139;34m▓'"${NC}"
            else
                block=$'\033[38;2;0;200;83m█'"${NC}"
            fi
            graph_lines[day_idx]+="$block"
        done
    done <<< "$blocks"

    echo ""
    echo -e "  ${C_DIM}${total} contributions this year${NC}"
    echo ""
    echo -e "  ${C_DIM}M${NC} ${graph_lines[1]}"
    echo -e "  ${C_DIM}W${NC} ${graph_lines[3]}"
    echo -e "  ${C_DIM}F${NC} ${graph_lines[5]}"
    echo ""
    echo -e "  ${C_DIM}░${NC}${C_DIM} none${NC}  \033[38;2;22;101;52m▒${NC}${C_DIM} low${NC}  \033[38;2;34;139;34m▓${NC}${C_DIM} med${NC}  \033[38;2;0;200;83m█${NC}${C_DIM} high${NC}"
}

draw_user_card() {
    local username="$1"
    local w=56

    [[ -z "$GH_USER_DATA" ]] && return 0

    local name followers public_repos total_private_repos
    name=$(echo "$GH_USER_DATA" | jq -r '.name // .login')
    followers=$(echo "$GH_USER_DATA" | jq -r '.followers // 0')
    public_repos=$(echo "$GH_USER_DATA" | jq -r '.public_repos // 0')
    total_private_repos=$(echo "$GH_USER_DATA" | jq -r '.total_private_repos // .owned_private_repos // 0')

    local contrib_tmpfile
    contrib_tmpfile=$(mktemp)

    (draw_contribution_graph "$username" > "$contrib_tmpfile" 2>/dev/null) &
    local contrib_pid=$!

    local private_repos="$total_private_repos"
    if [[ "$private_repos" == "0" || "$private_repos" == "null" ]]; then
        local priv_tmpfile
        priv_tmpfile=$(mktemp)
        (gh repo list --limit 10000 --json isPrivate --jq '[.[] | select(.isPrivate == true)] | length' 2>/dev/null > "$priv_tmpfile" || echo "0" > "$priv_tmpfile") &
        local priv_pid=$!
        animate_spinner $priv_pid "Loading profile..."
        private_repos=$(cat "$priv_tmpfile" 2>/dev/null || echo "0")
        rm -f "$priv_tmpfile"
    fi

    echo ""
    draw_box $w "GITHUB"
    draw_spacer $w
    draw_box_row $w "${C_BRIGHT}${BOLD}  ◉ ${name}${NC}"
    draw_box_row $w "${C_DIM}    @${username}${NC}"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  ${BULLET} ${public_repos} public  ${BULLET} ${private_repos} private  ${BULLET} ${followers} followers${NC}"
    draw_box_bottom $w

    if kill -0 "$contrib_pid" 2>/dev/null; then
        animate_spinner $contrib_pid "Loading contributions..."
    fi
    wait "$contrib_pid" 2>/dev/null || true
    cat "$contrib_tmpfile"
    rm -f "$contrib_tmpfile"
}

