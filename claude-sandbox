# Mounting several sibling repos is the common case, so offer them as a
# multi-select instead of making you type each path.
offer_sibling_mounts() {
    local parent
    parent=$(dirname "$LOCAL_PATH")
    [[ -d "$parent" ]] || return 0

    local siblings=() dir
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        [[ "$dir" == "$LOCAL_PATH" ]] && continue
        [[ -e "$dir/.git" ]] || continue

        local already=false ep
        for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
            [[ "$(mount_path "$ep")" == "$dir" ]] && { already=true; break; }
        done
        [[ "$already" == true ]] && continue

        siblings+=("$(basename "$dir")")
    done < <(find "$parent" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)

    [[ ${#siblings[@]} -gt 0 ]] || return 0

    echo ""
    echo -e "  ${C_DIM}Repos next to ${C_TEXT}$(basename "$LOCAL_PATH")${C_DIM} — space to select, enter to confirm, esc to skip${NC}"
    echo ""

    local picked
    picked=$(printf '%s\n' "${siblings[@]}" | gum choose --no-limit --height=12 \
        --header "Mount alongside $(basename "$LOCAL_PATH")?" 2>/dev/null) || return 0

    [[ -n "$picked" ]] || return 0

    local name
    while IFS= read -r name; do
        [[ -n "$name" ]] && validate_and_add_extra_path "${parent}/${name}"
    done <<< "$picked"
}

prompt_extra_mounts() {
    offer_sibling_mounts

    while true; do
