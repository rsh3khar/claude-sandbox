    draw_separator $w
    draw_spacer $w
    draw_box_row $w "  ${C_WARN}★${NC} ${stars}    ${C_DIM}⑂${NC} ${forks}    ${C_BLUE}◆${NC} ${lang}    ${C_DIM}⟳${NC} ${pushed}"
    draw_spacer $w
    draw_box_bottom $w

    echo ""

    if gum confirm "Use this repository?"; then
