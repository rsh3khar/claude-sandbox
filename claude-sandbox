# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Subcommands                                                             │
# └─────────────────────────────────────────────────────────────────────────┘

cmd_ps() {
    local ids
    ids=$(list_sandbox_ids)

    if [[ -z "$ids" ]]; then
        say_dim "No running sandboxes"
        return 0
    fi

    printf "  %-22s %-10s %-8s %s\n" "NAME" "STARTED" "MODE" "WORKSPACES"

    local id name started mode workspaces first
    for id in $ids; do
        name=$(docker inspect --format '{{.Name}}' "$id" | sed 's|^/||')
        started=$(docker inspect --format '{{.State.StartedAt}}' "$id" | cut -dT -f1)
        mode=$(docker inspect --format "{{index .Config.Labels \"${LABEL_NS}.mode\"}}" "$id" 2>/dev/null || echo "-")
        workspaces=$(docker inspect --format '{{range .Mounts}}{{.Destination}}={{.Source}}{{println}}{{end}}' "$id" \
            | grep '^/home/node/workspace/' | cut -d= -f2- | sort)

        first=1
        while IFS= read -r m; do
            [[ -z "$m" ]] && continue
            if [[ "$first" == "1" ]]; then
                printf "  ${C_ACCENT}%-22s${NC} %-10s %-8s %s\n" "$name" "$started" "$mode" "$m"
                first=0
            else
                printf "  %-22s %-10s %-8s %s\n" "" "" "" "$m"
            fi
        done <<< "$workspaces"

        [[ "$first" == "1" ]] && printf "  ${C_ACCENT}%-22s${NC} %-10s %-8s %s\n" "$name" "$started" "$mode" "(cloned in container)"
    done
}

cmd_attach() {
    local name
    name=$(resolve_container "${1:-}") || return 1
    [[ -z "$name" ]] && return 1

    echo -e "  ${C_DIM}Attaching to ${C_ACCENT}${name}${C_DIM}...${NC}"
    docker exec -it "$name" zsh
}

cmd_kill() {
    local target="${1:-}"

    if [[ "$target" == "--all" || "$target" == "-a" ]]; then
        local ids
        ids=$(list_sandbox_ids)
        [[ -z "$ids" ]] && { say_dim "No running sandboxes"; return 0; }

        if [[ "$ASSUME_YES" != true ]]; then
            echo ""
            cmd_ps
            echo ""
            gum confirm "Kill all running sandboxes?" || return 0
        fi
        # shellcheck disable=SC2086
        docker rm -f $ids >/dev/null
        say_ok "Killed all sandboxes"
        return 0
    fi

    local name
    name=$(resolve_container "$target") || return 1
    [[ -z "$name" ]] && return 1

    if [[ "$ASSUME_YES" != true ]]; then
        gum confirm "Kill ${name}?" || return 0
    fi
    docker rm -f "$name" >/dev/null
    say_ok "Killed ${name}"
}

# A sandbox whose terminal is gone still holds mounts and can keep auto-committing.
cmd_orphans() {
    local clients
    clients=$(ps -axo command 2>/dev/null | grep -E "docker (run|exec|attach)" | grep -v grep || true)

    local found=0 id name
    for id in $(list_sandbox_ids); do
        name=$(docker inspect --format '{{.Name}}' "$id" | sed 's|^/||')
        if grep -qF -- "$name" <<< "$clients"; then
            printf "  %-22s ${C_SUCCESS}attached${NC}\n" "$name"
        else
            printf "  %-22s ${C_WARN}ORPHAN${NC} ${C_DIM}(no docker client found)${NC}\n" "$name"
            found=1
        fi
    done

    if [[ "$found" == "1" ]]; then
        echo ""
        echo -e "  ${C_DIM}Kill one with:  ${C_TEXT}cs kill <name>${NC}"
        echo -e "  ${C_DIM}Kill them all:  ${C_TEXT}cs kill --all${NC}"
    elif [[ -z "$(list_sandbox_ids)" ]]; then
        say_dim "No running sandboxes"
    fi
}

cmd_doctor() {
    echo ""
    draw_mini_logo
    echo ""
    echo -e "  ${C_TEXT}${BOLD}Host checks${NC}"
    echo ""

    local ok=true

    for dep in docker gh gum jq git; do
        if command -v "$dep" &>/dev/null; then
            say_ok "${dep} ${C_DIM}($(command -v "$dep"))${NC}"
        else
            say_err "${dep} missing"
            ok=false
        fi
    done

    if docker info &>/dev/null; then
        local runtime
        runtime=$(docker info --format '{{.Name}}' 2>/dev/null || echo "unknown")
        say_ok "Docker daemon reachable ${C_DIM}(${runtime})${NC}"
        if docker info --format '{{json .}}' 2>/dev/null | grep -qi orbstack; then
            say_ok "OrbStack detected ${C_DIM}(host networking supported)${NC}"
        else
            say_warn "${C_DIM}Not OrbStack — Docker Desktop needs host networking enabled in Settings > Resources > Network, or use ${C_TEXT}--network bridge -p PORT:PORT${NC}"
        fi
    else
        say_err "Docker daemon not reachable"
        ok=false
    fi

    if gh auth status &>/dev/null; then
        say_ok "GitHub CLI authenticated"
    else
        say_warn "GitHub CLI not authenticated ${C_DIM}(run: gh auth login)${NC}"
    fi

    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
        say_ok "Claude auth via CLAUDE_CODE_OAUTH_TOKEN"
    elif [[ -f "$HOME/.claude-sandbox-token" ]]; then
        local perms
        perms=$(stat -f '%Lp' "$HOME/.claude-sandbox-token" 2>/dev/null || stat -c '%a' "$HOME/.claude-sandbox-token" 2>/dev/null || echo "?")
        if [[ "$perms" == "600" ]]; then
            say_ok "Token file present ${C_DIM}(chmod 600)${NC}"
        else
            say_warn "Token file is chmod ${perms} ${C_DIM}— run: chmod 600 ~/.claude-sandbox-token${NC}"
        fi
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        say_ok "Claude auth via ANTHROPIC_API_KEY"
    else
        say_warn "No Claude auth ${C_DIM}(run: claude setup-token)${NC}"
    fi

    if ssh-add -l &>/dev/null; then
        say_ok "SSH agent has keys loaded"
    else
        say_warn "SSH agent has no keys ${C_DIM}(run: ssh-add)${NC}"
    fi

    if image_exists_locally "$IMAGE_LOCAL"; then
        local created
        created=$(docker image inspect "$IMAGE_LOCAL" --format '{{.Created}}' | cut -dT -f1)
        say_ok "Image present ${C_DIM}(built ${created})${NC}"
    else
        say_warn "No local image ${C_DIM}(will pull or build on first launch)${NC}"
    fi

    echo ""
    [[ "$ok" == true ]] && say_ok "${C_TEXT}Ready${NC}" || say_err "Some checks failed"
    echo ""
}

cmd_update() {
    echo ""
    draw_mini_logo
    echo ""

    local registry_ref="${IMAGE_REGISTRY}:v${VERSION}"
    if [[ "$PULL_POLICY" != "never" ]] && pull_image "$registry_ref"; then
        docker tag "$registry_ref" "$IMAGE_LOCAL"
        say_ok "Updated to ${registry_ref}"
    elif can_build_locally; then
        say_dim "Registry unavailable — rebuilding locally"
        build_image --pull
    else
        die "Could not pull ${registry_ref} and no Dockerfile to build from"
    fi
    echo ""
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Current Directory Detection                                             │
# └─────────────────────────────────────────────────────────────────────────┘

detect_current_repo() {
    git rev-parse --git-dir &>/dev/null || return 0

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0

    local remote_url display_name
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ -n "$remote_url" ]]; then
        if [[ "$remote_url" == git@* ]]; then
            display_name=$(echo "$remote_url" | sed 's/.*://' | sed 's/\.git$//')
        else
            display_name=$(echo "$remote_url" | sed -E 's|https?://[^/]+/||' | sed 's/\.git$//')
        fi
    else
        display_name=$(basename "$repo_root")
    fi

    local w=56
    clear
    echo ""
    draw_mini_logo
    echo ""

    draw_box $w "CURRENT DIRECTORY"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Detected git repository:${NC}"
    draw_box_row $w "${C_BRIGHT}  ${display_name}${NC}"
    draw_box_row $w "${C_DIM}  ${repo_root}${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    if gum confirm "Use this repository?"; then
        LOCAL_MODE=true
        LOCAL_PATH="$repo_root"
        SELECTED_REPO=$(basename "$repo_root")
        EXTRA_PATHS=()
        load_config_file "$LOCAL_PATH/$REPO_CONFIG_FILE"
        prompt_extra_mounts
    fi
}

