# Where the work lives decides whether auto-save is worth its noise.
#
#   local mode  - the repo is a bind mount, so every write is already on the
#                 host. A killed container loses nothing; auto-save would only
#                 add "auto-save #47" commits. Off.
#   github mode - the clone lives inside the container. If it dies, unpushed
#                 work is gone for good. On.
apply_autosave_default() {
    is_explicit AUTO_GIT && return 0
    if [[ "$LOCAL_MODE" != true ]]; then
        AUTO_GIT=true
    fi
}

screen_launch_confirm() {
    apply_autosave_default
    clear
    echo ""
    draw_mini_logo
    echo ""

    draw_launch_summary

    echo ""
    echo -e "  ${C_DIM}Claude Code will run with ${C_ACCENT}--dangerously-skip-permissions${NC}"
    echo ""

    if [[ "$ASSUME_YES" == true ]]; then
        return 0
    fi

    # Defaults follow the current values, so config/flags win and Enter is safe
    gum confirm --default="$AUTO_GIT" "Enable auto-save (commit every ${AUTO_GIT_INTERVAL}s)?" && AUTO_GIT=true || AUTO_GIT=false
    gum confirm --default="$BROWSER" "Enable headless browser (Playwright)?" && BROWSER=true || BROWSER=false
    gum confirm --default="$UPDATE_TOOLS" "Update CLI tools on start?" && UPDATE_TOOLS=true || UPDATE_TOOLS=false

    echo ""
    gum confirm "Launch sandbox?" || return 1
    return 0
}

