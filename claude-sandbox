confirm_repo() {
    local repo="$1"
    local w=56

    clear
    echo ""
    draw_mini_logo
    echo ""

    # Fetch repo details
    local info info_tmpfile
    info_tmpfile=$(mktemp)
    (gh repo view "$repo" --json name,owner,description,stargazerCount,forkCount,primaryLanguage,pushedAt 2>/dev/null > "$info_tmpfile" || true) &
    animate_spinner $! "Fetching repository..."
    info=$(cat "$info_tmpfile" 2>/dev/null || echo "")
    rm -f "$info_tmpfile"

    if [[ -z "$info" ]]; then
        echo -e "  ${C_ERROR}${CROSS}${NC} Could not fetch repository info"
        sleep 1
        return
    fi

    local name owner desc stars forks lang pushed
    name=$(echo "$info" | jq -r '.name // ""')
    owner=$(echo "$info" | jq -r '.owner.login // ""')
    desc=$(echo "$info" | jq -r '.description // ""' | head -c 45)
    stars=$(echo "$info" | jq -r '.stargazerCount // 0')
    forks=$(echo "$info" | jq -r '.forkCount // 0')
    lang=$(echo "$info" | jq -r '.primaryLanguage.name // "—"')
    pushed=$(echo "$info" | jq -r '.pushedAt // ""')

    if [[ -n "$pushed" ]]; then
        pushed=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$pushed" "+%b %d" 2>/dev/null || echo "")
    fi

    draw_box $w "REPOSITORY"
    draw_spacer $w
    draw_box_row $w "${C_BRIGHT}${BOLD}  ${owner}/${name}${NC}"
    if [[ -n "$desc" ]]; then
        draw_box_row $w "${C_DIM}  ${desc}${NC}"
    fi
    draw_spacer $w
    draw_separator $w
    draw_spacer $w
    draw_box_row $w "  ${C_WARN}★${NC} ${stars}    ${C_DIM}⑂${NC} ${forks}    ${C_BLUE}◆${NC} ${lang}    ${C_DIM}⟳${NC} ${pushed}"
    draw_spacer $w
    draw_box_bottom $w

    echo ""

    if gum confirm "Use this repository?"; then
        SELECTED_REPO="$repo"
        local url_tmpfile
        url_tmpfile=$(mktemp)
        (gh repo view "$repo" --json sshUrl --jq '.sshUrl' 2>/dev/null > "$url_tmpfile" || true) &
        animate_spinner $! "Resolving URL..."
        SELECTED_REPO_URL=$(cat "$url_tmpfile" 2>/dev/null || echo "")
        rm -f "$url_tmpfile"
    fi
}

