# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Argument Parsing                                                        │
# └─────────────────────────────────────────────────────────────────────────┘

POSITIONAL=()

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)        ASSUME_YES=true; shift ;;
            -b|--branch)     SANDBOX_BRANCH="${2:?--branch needs a value}"; shift 2 ;;
            -m|--mount)      POSITIONAL+=("${2:?--mount needs a path}"); shift 2 ;;
            -n|--name)       CONTAINER_NAME="${2:?--name needs a value}"; shift 2 ;;
            -w|--worktree)   WORKTREE=true; mark_explicit WORKTREE; shift ;;
            --no-worktree)   WORKTREE=false; mark_explicit WORKTREE; shift ;;
            --agent)         AGENT="${2:?--agent needs a value}"; mark_explicit AGENT; shift 2 ;;
            --snapshot)      SNAPSHOT=true; mark_explicit SNAPSHOT; shift ;;
            --no-snapshot)   SNAPSHOT=false; mark_explicit SNAPSHOT; shift ;;
            --auto-git)      AUTO_GIT=true; mark_explicit AUTO_GIT; shift ;;
            --no-auto-git)   AUTO_GIT=false; mark_explicit AUTO_GIT; shift ;;
            --interval)      AUTO_GIT_INTERVAL="${2:?--interval needs a value}"; mark_explicit AUTO_GIT_INTERVAL; shift 2 ;;
            --browser)       BROWSER=true; mark_explicit BROWSER; shift ;;
            --no-browser)    BROWSER=false; mark_explicit BROWSER; shift ;;
            --update-tools)  UPDATE_TOOLS=true; mark_explicit UPDATE_TOOLS; shift ;;
            --network)       NETWORK="${2:?--network needs a value}"; mark_explicit NETWORK; shift 2 ;;
            -p|--publish)    PUBLISH_PORTS+=("${2:?--publish needs a value}"); NETWORK="bridge"; mark_explicit NETWORK; shift 2 ;;
            --image)         IMAGE_REF="${2:?--image needs a value}"; mark_explicit IMAGE_REF; shift 2 ;;
            --pull)          PULL_POLICY="always"; mark_explicit PULL_POLICY; shift ;;
            --no-pull)       PULL_POLICY="never"; mark_explicit PULL_POLICY; shift ;;
            --dry-run)       DRY_RUN=true; ASSUME_YES=true; shift ;;
            -h|--help)       show_help; exit 0 ;;
            -v|--version)    echo "claude-sandbox ${VERSION}"; exit 0 ;;
            --)              shift; POSITIONAL+=("$@"); break ;;
            -*)              die "Unknown option: $1  (try: claude-sandbox --help)" ;;
            *)               POSITIONAL+=("$1"); shift ;;
        esac
    done
}

# Set up SELECTED_REPO / LOCAL_MODE from a target argument
resolve_target() {
    local input="$1"

    if [[ "$input" == "." || "$input" == ".." || "$input" == /* || "$input" == ~* || -d "$input" ]]; then
        LOCAL_MODE=true
        LOCAL_PATH=$(abs_path_of "$input") || die "Directory not found: ${input}"

        # Running from a subdirectory should sandbox the whole repo
        local root
        root=$(git_root_of "$LOCAL_PATH") || true
        if [[ -n "$root" && "$root" != "$LOCAL_PATH" ]]; then
            [[ "$DRY_RUN" == true ]] || say_dim "Using repo root ${root}"
            LOCAL_PATH="$root"
        fi

        SELECTED_REPO=$(basename "$LOCAL_PATH")

        if [[ -z "$root" ]]; then
            # Not a git repo: still useful to sandbox, just say so plainly
            [[ "$DRY_RUN" == true ]] || say_warn "Not a git repo — no branches, no auto-save: ${C_DIM}${LOCAL_PATH}${NC}"
            AUTO_GIT=false
            WORKTREE=false
        fi

        load_config_file "$LOCAL_PATH/$REPO_CONFIG_FILE"
        add_mounts_from_config "$LOCAL_PATH"
        [[ "$DRY_RUN" == true ]] || say_ok "Local repo: ${C_ACCENT}${SELECTED_REPO}${NC}"
        return 0
    fi

    LOCAL_MODE=false
    if [[ "$input" == http* || "$input" == git@* ]]; then
        SELECTED_REPO_URL="$input"
        SELECTED_REPO=$(basename "$input" .git)
    else
        SELECTED_REPO_URL=$(gh repo view "$input" --json sshUrl --jq '.sshUrl' 2>/dev/null || echo "")
        SELECTED_REPO="$input"
        [[ -n "$SELECTED_REPO_URL" ]] || die "Repository not found: ${input}"
    fi
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Entry Point                                                             │
# └─────────────────────────────────────────────────────────────────────────┘

main() {
    load_config_file "$CONFIG_FILE"

    # Dispatch management subcommands before generic parsing
    case "${1:-}" in
        ps)      shift; check_deps; cmd_ps "$@"; exit 0 ;;
        exec)    shift; check_deps; cmd_exec "$@"; exit $? ;;
        attach)  shift; check_deps; cmd_attach "${1:-}"; exit 0 ;;
        kill)    shift; check_deps; parse_args "$@"; cmd_kill "${POSITIONAL[0]:-${1:-}}"; exit 0 ;;
        orphans) shift; check_deps; cmd_orphans; exit 0 ;;
        worktrees) shift; cmd_worktrees; exit 0 ;;
        doctor)  shift; cmd_doctor; exit 0 ;;
        update)  shift; check_deps; parse_args "$@"; cmd_update; exit 0 ;;
        version) echo "claude-sandbox ${VERSION}"; exit 0 ;;
        help)    show_help; exit 0 ;;
        run)     shift ;;
    esac

    parse_args "$@"
    set -- ${POSITIONAL[@]+"${POSITIONAL[@]}"}

    check_deps

    # Direct invocation with a target
    if [[ $# -gt 0 ]]; then
        resolve_target "$1"
        shift

        EXTRA_PATHS=()
        for extra_arg in "$@"; do
            validate_and_add_extra_path "$extra_arg" \
                || say_err "Skipping invalid extra path: ${extra_arg}"
        done

        if [[ "$DRY_RUN" == true ]]; then
            launch_sandbox
            exit 0
        fi

        if screen_launch_confirm; then
            launch_sandbox
        fi
        exit 0
    fi

    # Interactive mode
    screen_welcome
    detect_current_repo

    if [[ -z "$SELECTED_REPO" ]]; then
        screen_source_select
    fi

    screen_main_menu
}

# Only run when executed, so tests can source this file
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    trap cleanup_terminal EXIT INT TERM
    main "$@"
fi
