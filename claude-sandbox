status_dot() {
    local status="$1"
    case "$status" in
        "ok")      echo -e "${C_SUCCESS}${DOT}${NC}" ;;
        "warn")    echo -e "${C_WARN}${DOT}${NC}" ;;
        "error")   echo -e "${C_ERROR}${DOT}${NC}" ;;
        "pending") echo -e "${C_DIM}${RING}${NC}" ;;
        *)         echo -e "${C_DIM}${DOT}${NC}" ;;
    esac
}

animate_spinner() {
    local pid=$1
    local msg="${2:-Loading}"
    local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local i=0

    # Ensure cursor is restored on exit
    trap 'tput cnorm 2>/dev/null' RETURN

    tput civis 2>/dev/null || true  # Hide cursor
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${C_ACCENT}${frames[$i]}${NC} ${C_DIM}${msg}${NC}  "
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.08
    done
    printf "\r%50s\r" ""  # Clear line
    tput cnorm 2>/dev/null || true  # Show cursor
}

progress_bar() {
    local current=$1 total=$2 width=${3:-30}
    local pct=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))

    printf "${C_ACCENT}"
    printf '%*s' "$filled" '' | tr ' ' '█'
    printf "${C_DIM}"
    printf '%*s' "$empty" '' | tr ' ' '░'
    printf "${NC} ${C_TEXT}%3d%%${NC}" "$pct"
}

