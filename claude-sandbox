# │ Image Management                                                        │
# └─────────────────────────────────────────────────────────────────────────┘

image_exists_locally() {
    docker image inspect "$1" &>/dev/null
}

can_build_locally() {
    [[ -f "$SCRIPT_DIR/Dockerfile" ]]
}

build_image() {
    local extra_args=("$@")
    echo ""
    echo -e "  ${C_ACCENT}${BULLET}${NC} ${C_TEXT}Building sandbox image...${NC}"
    echo ""
    DOCKER_BUILDKIT=1 docker build \
        --build-arg "VERSION=${VERSION}" \
        "${extra_args[@]+"${extra_args[@]}"}" \
        -t "$IMAGE_LOCAL" "$SCRIPT_DIR" 2>&1 | while read -r line; do
        echo -e "    ${C_DIM}${line}${NC}"
    done
    echo ""
    say_ok "Image ready"
}

pull_image() {
    local ref="$1"
    local tmpfile
    tmpfile=$(mktemp)
    (docker pull --quiet "$ref" >/dev/null 2>&1 && echo ok > "$tmpfile") &
    animate_spinner $! "Pulling ${ref}..."
    local result
    result=$(cat "$tmpfile" 2>/dev/null || echo "")
    rm -f "$tmpfile"
    [[ "$result" == "ok" ]]
}

# Decide which image to run and make sure it exists locally.
# Order: explicit --image > local image (unless --pull) > registry > local build
resolve_image() {
    if [[ -n "$IMAGE_REF" ]]; then
        if ! image_exists_locally "$IMAGE_REF"; then
            pull_image "$IMAGE_REF" || die "Image not found: $IMAGE_REF"
        fi
        return 0
    fi

    local registry_ref="${IMAGE_REGISTRY}:v${VERSION}"

    if [[ "$PULL_POLICY" != "always" ]] && image_exists_locally "$IMAGE_LOCAL"; then
        IMAGE_REF="$IMAGE_LOCAL"
        return 0
    fi

    if [[ "$PULL_POLICY" != "never" ]] && pull_image "$registry_ref"; then
        docker tag "$registry_ref" "$IMAGE_LOCAL" 2>/dev/null || true
        IMAGE_REF="$registry_ref"
        say_ok "Pulled ${C_DIM}${registry_ref}${NC}"
        return 0
    fi

    if can_build_locally; then
        [[ "$PULL_POLICY" == "never" ]] || say_dim "Registry unavailable — building locally"
        build_image
        IMAGE_REF="$IMAGE_LOCAL"
        return 0
    fi

    die "No image available. Pull failed and no Dockerfile found in ${SCRIPT_DIR}"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Pre-session Snapshot                                                    │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Opt-in (--snapshot). Killing the container does NOT lose local work: a bind
# mount writes through to the host as the agent types, so uncommitted files
# are already on disk. The only thing this covers is the agent itself deleting
# or overwriting something git cannot restore — i.e. untracked files. That is
# rare enough not to be worth doing to every repo by default.
#
# Records the working tree (tracked AND untracked, ignored files excluded) as
# a commit object under a private ref. Never touches HEAD, the index, the
# working tree, or the stash — staging goes through a temporary index.

readonly SNAPSHOT_REF_PREFIX="refs/claude-sandbox/pre-session"
readonly SNAPSHOT_KEEP=10
SNAPSHOT_REFS=()   # "repo_path|ref" per snapshotted repo

# Every mounted folder is writable, not just the primary one, so snapshot each
# git repo in the session.
snapshot_all_repos() {
    [[ "$SNAPSHOT" == true && "$LOCAL_MODE" == true ]] || return 0

    SNAPSHOT_REFS=()

    # The primary repo, unless it's already isolated behind a worktree
    [[ -z "$WORKTREE_PATH" ]] && snapshot_repo "$LOCAL_PATH"

    local ep path
    for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
        [[ "$(mount_mode "$ep")" == "ro" ]] && continue   # can't be damaged
        path=$(mount_path "$ep")
        snapshot_repo "$path"
    done

    return 0
}

snapshot_repo() {
    local repo="$1"

    [[ "$SNAPSHOT" == true ]] || return 0
    [[ -d "$repo" ]] || return 0
    git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1 || return 0

    local ts ref tmp_index parent tree commit head_tree
    ts=$(date +%Y%m%d-%H%M%S)
    ref="${SNAPSHOT_REF_PREFIX}/${ts}"
    tmp_index=$(mktemp -u -t cs-index.XXXXXX)
    parent=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || return 0

    (
        export GIT_INDEX_FILE="$tmp_index"
        git -C "$repo" read-tree HEAD 2>/dev/null &&
            git -C "$repo" add -A 2>/dev/null &&
            git -C "$repo" write-tree 2>/dev/null
    ) > "${tmp_index}.tree" 2>/dev/null || { rm -f "$tmp_index" "${tmp_index}.tree"; return 0; }

    tree=$(cat "${tmp_index}.tree" 2>/dev/null | tail -1)
    rm -f "$tmp_index" "${tmp_index}.tree"
    [[ -n "$tree" ]] || return 0

    # Nothing uncommitted? HEAD already is the restore point.
    head_tree=$(git -C "$repo" rev-parse "HEAD^{tree}" 2>/dev/null || echo "")
    if [[ "$tree" == "$head_tree" ]]; then
        return 0
    fi

    # Identity must be supplied explicitly: commit-tree refuses to run when the
    # machine has no user.email configured, which would make snapshots fail
    # silently on exactly the setups least likely to notice.
    commit=$(git -C "$repo" \
        -c user.name="claude-sandbox" \
        -c user.email="claude-sandbox@localhost" \
        commit-tree "$tree" -p "$parent" \
        -m "claude-sandbox: working tree before session ${ts}" 2>/dev/null) || return 0
    git -C "$repo" update-ref "$ref" "$commit" 2>/dev/null || return 0

    SNAPSHOT_REFS+=("${repo}|${ref}")
    prune_snapshots "$repo"
}

# Keep the most recent N; these are cheap but shouldn't grow forever.
prune_snapshots() {
    local repo="$1" old
    while IFS= read -r old; do
        [[ -n "$old" ]] && git -C "$repo" update-ref -d "$old" 2>/dev/null || true
    done < <(git -C "$repo" for-each-ref --format='%(refname)' --sort=-refname \
        "${SNAPSHOT_REF_PREFIX}/*" 2>/dev/null | tail -n +$((SNAPSHOT_KEEP + 1)))
}

report_snapshot() {
    [[ ${#SNAPSHOT_REFS[@]} -gt 0 ]] || return 0

    local entry repo ref changed shown=false
    for entry in "${SNAPSHOT_REFS[@]}"; do
        repo="${entry%%|*}"
        ref="${entry##*|}"
        changed=$(git -C "$repo" diff --stat "$ref" 2>/dev/null | tail -1)
        [[ -n "$changed" ]] || continue

        if [[ "$shown" == false ]]; then
            echo ""
            say_ok "Pre-session snapshots — nothing you had is lost:"
            shown=true
        fi
        echo -e "     ${C_ACCENT}$(basename "$repo")${NC} ${C_DIM}${changed# }${NC}"
        echo -e "       ${C_DIM}review:  ${C_TEXT}git -C $(printf '%q' "$repo") show --stat ${ref}${NC}"
        echo -e "       ${C_DIM}restore: ${C_TEXT}git -C $(printf '%q' "$repo") restore --source=${ref} -- .${NC}"
    done
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Worktree Isolation                                                      │
# └─────────────────────────────────────────────────────────────────────────┘
#
# With --worktree the agent gets its own git worktree on a scratch branch
# instead of your working tree. Your checkout is never touched, but the
# commits land in your repo's object store, so `git log <branch>` and
# `git merge` work immediately on the host.
#
# The worktree's .git is a *file* pointing at an absolute path inside the main
# repo, so the container gets that path bind-mounted at the identical location
# — that's what makes git fully functional inside the sandbox.

readonly WORKTREE_ROOT="${CLAUDE_SANDBOX_WORKTREES:-$HOME/.claude-sandbox-worktrees}"


setup_worktree() {
    local repo_path="$1"
    local branch="${2:-}"

    if [[ -z "$branch" ]]; then
        branch="sandbox/$(date +%Y%m%d-%H%M%S)"
    fi

    local slug
    slug="$(slugify "$(basename "$repo_path")")-$(slugify "$branch")"
    WORKTREE_PATH="${WORKTREE_ROOT}/${slug}"

    # --dry-run must not touch the repo: compute the path, create nothing.
    if [[ "$DRY_RUN" == true ]]; then
        return 0
    fi

    if [[ -d "$WORKTREE_PATH" ]]; then
        say_ok "Reusing worktree ${C_DIM}${WORKTREE_PATH}${NC}"
        return 0
    fi

    mkdir -p "$WORKTREE_ROOT"

    local out
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
        out=$(git -C "$repo_path" worktree add "$WORKTREE_PATH" "$branch" 2>&1)
    else
        out=$(git -C "$repo_path" worktree add "$WORKTREE_PATH" -b "$branch" 2>&1)
    fi || {
        say_err "Could not create worktree: ${out}"
        return 1
    }

    WORKTREE_CREATED=true
    say_ok "Worktree ${C_ACCENT}${branch}${NC} ${C_DIM}(${WORKTREE_PATH})${NC}"
}

# Where the main repo's .git must appear *inside* the container.
#
# A worktree's .git file holds an absolute "gitdir:" path, and git resolves
# symlinks when writing it — on macOS /tmp and /var are symlinks, so the
# recorded path rarely equals "$LOCAL_PATH/.git". Read the reference back
# rather than assuming, or the mount lands somewhere git never looks.
worktree_gitdir_target() {
    local ref parent
    if [[ -f "$WORKTREE_PATH/.git" ]]; then
        ref=$(sed -n 's/^gitdir: *//p' "$WORKTREE_PATH/.git" 2>/dev/null | head -1)
        if [[ -n "$ref" && "$ref" == */worktrees/* ]]; then
            parent="${ref%%/worktrees/*}"
            [[ -n "$parent" ]] && { echo "$parent"; return 0; }
        fi
    fi

    # Not created yet (dry-run): best-effort physical path
    local physical
    physical=$(cd "$LOCAL_PATH" 2>/dev/null && pwd -P) || physical="$LOCAL_PATH"
    echo "${physical}/.git"
}

# Offer to clean up an untouched worktree; never delete one with work in it.
cleanup_worktree() {
    [[ "$WORKTREE_CREATED" == true && -d "$WORKTREE_PATH" ]] || return 0

    local changes commits
    changes=$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    commits=$(git -C "$WORKTREE_PATH" log --oneline "$(git -C "$LOCAL_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null)".. 2>/dev/null | wc -l | tr -d ' ')

    echo ""
    if [[ "$changes" == "0" && "$commits" == "0" ]]; then
        git -C "$LOCAL_PATH" worktree remove --force "$WORKTREE_PATH" 2>/dev/null \
            && say_dim "Removed empty worktree"
        return 0
    fi

    local branch
    branch=$(git -C "$WORKTREE_PATH" branch --show-current 2>/dev/null)
    say_ok "Work kept on ${C_ACCENT}${branch}${NC}"
    echo -e "     ${C_DIM}${commits} commit(s), ${changes} uncommitted file(s)${NC}"
    echo -e "     ${C_DIM}Review:  ${C_TEXT}git -C $(printf '%q' "$LOCAL_PATH") log ${branch}${NC}"
    echo -e "     ${C_DIM}Merge:   ${C_TEXT}git -C $(printf '%q' "$LOCAL_PATH") merge ${branch}${NC}"
    echo -e "     ${C_DIM}Discard: ${C_TEXT}git -C $(printf '%q' "$LOCAL_PATH") worktree remove --force $(printf '%q' "$WORKTREE_PATH")${NC}"
}

