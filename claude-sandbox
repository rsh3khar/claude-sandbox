# Resolve a unique mount name, appending -2, -3, etc. on collision
resolve_mount_name() {
    local base="$1"
    local name="$base"
    local suffix=2
    local primary
    primary=$(basename "${SELECTED_REPO:-}")

    while true; do
        local collision=false
        if [[ "$name" == "$primary" ]]; then
            collision=true
        fi
        if [[ "$collision" == false ]]; then
            for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
                if [[ "$name" == "${ep##*:}" ]]; then
                    collision=true
                    break
                fi
            done
        fi
        [[ "$collision" == false ]] && break
        name="${base}-${suffix}"
        ((suffix++))
    done

    echo "$name"
}

# Validate a path and add it to EXTRA_PATHS. Returns 0 on success, 1 on failure.
validate_and_add_extra_path() {
    local raw_path="$1"

    raw_path="${raw_path/#\~/$HOME}"
    local abs_path
    abs_path=$(cd "$raw_path" 2>/dev/null && pwd) || {
        say_err "Directory not found: ${raw_path}"
        return 1
    }

    if [[ ! -e "$abs_path/.git" ]]; then
        say_err "Not a git repository: ${abs_path}"
        return 1
    fi

    if [[ "$abs_path" == "$LOCAL_PATH" ]]; then
        say_warn "Already the primary repo: ${abs_path}"
        return 1
    fi
    for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
        if [[ "$abs_path" == "${ep%%:*}" ]]; then
            say_warn "Already added: ${abs_path}"
            return 1
        fi
    done

    local mount_name
    mount_name=$(resolve_mount_name "$(basename "$abs_path")")
    EXTRA_PATHS+=("${abs_path}:${mount_name}")

    say_ok "Added: ${C_ACCENT}${mount_name}${NC} ${C_DIM}(${abs_path})${NC}"
    return 0
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Image Management                                                        │
# └─────────────────────────────────────────────────────────────────────────┘

image_exists_locally() {
    docker image inspect "$1" &>/dev/null
}

can_build_locally() {
    [[ -f "$SCRIPT_DIR/Dockerfile" ]]
}

build_image() {
    local extra_args=("$@")
    echo ""
    echo -e "  ${C_ACCENT}${BULLET}${NC} ${C_TEXT}Building sandbox image...${NC}"
    echo ""
    DOCKER_BUILDKIT=1 docker build \
        --build-arg "VERSION=${VERSION}" \
        "${extra_args[@]+"${extra_args[@]}"}" \
        -t "$IMAGE_LOCAL" "$SCRIPT_DIR" 2>&1 | while read -r line; do
        echo -e "    ${C_DIM}${line}${NC}"
    done
    echo ""
    say_ok "Image ready"
}

pull_image() {
    local ref="$1"
    local tmpfile
    tmpfile=$(mktemp)
    (docker pull --quiet "$ref" >/dev/null 2>&1 && echo ok > "$tmpfile") &
    animate_spinner $! "Pulling ${ref}..."
    local result
    result=$(cat "$tmpfile" 2>/dev/null || echo "")
    rm -f "$tmpfile"
    [[ "$result" == "ok" ]]
}

# Decide which image to run and make sure it exists locally.
# Order: explicit --image > local image (unless --pull) > registry > local build
resolve_image() {
    if [[ -n "$IMAGE_REF" ]]; then
        if ! image_exists_locally "$IMAGE_REF"; then
            pull_image "$IMAGE_REF" || die "Image not found: $IMAGE_REF"
        fi
        return 0
    fi

    local registry_ref="${IMAGE_REGISTRY}:v${VERSION}"

    if [[ "$PULL_POLICY" != "always" ]] && image_exists_locally "$IMAGE_LOCAL"; then
        IMAGE_REF="$IMAGE_LOCAL"
        return 0
    fi

    if [[ "$PULL_POLICY" != "never" ]] && pull_image "$registry_ref"; then
        docker tag "$registry_ref" "$IMAGE_LOCAL" 2>/dev/null || true
        IMAGE_REF="$registry_ref"
        say_ok "Pulled ${C_DIM}${registry_ref}${NC}"
        return 0
    fi

    if can_build_locally; then
        [[ "$PULL_POLICY" == "never" ]] || say_dim "Registry unavailable — building locally"
        build_image
        IMAGE_REF="$IMAGE_LOCAL"
        return 0
    fi

    die "No image available. Pull failed and no Dockerfile found in ${SCRIPT_DIR}"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Container Naming & Discovery                                            │
# └─────────────────────────────────────────────────────────────────────────┘

# Deterministic, collision-free container name: cs-<repo>[-N]
generate_container_name() {
    local base
    base="cs-$(slugify "$(basename "${SELECTED_REPO:-sandbox}")")"
    local name="$base"
    local suffix=2
    while docker ps -a --format '{{.Names}}' | grep -qx "$name"; do
        name="${base}-${suffix}"
        ((suffix++))
    done
    echo "$name"
}

# All discovery goes through our own label, not `ancestor=`: the image tag
# changes between local builds and registry pulls, so ancestor filters silently
# stop matching.
list_sandbox_ids() {
    docker ps -q --filter "label=${LABEL_NS}.managed=true"
}

pick_container() {
    local prompt="${1:-Pick a sandbox}"
    local names=()
    while IFS= read -r n; do
        [[ -n "$n" ]] && names+=("$n")
    done < <(docker ps --filter "label=${LABEL_NS}.managed=true" --format '{{.Names}}')

    if [[ ${#names[@]} -eq 0 ]]; then
        say_warn "No running sandboxes"
        return 1
    fi
    if [[ ${#names[@]} -eq 1 ]]; then
        echo "${names[0]}"
        return 0
    fi
    printf '%s\n' "${names[@]}" | gum choose --header "$prompt" --height=10
}

resolve_container() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        pick_container "Pick a sandbox"
        return
    fi

    # Exact name match
    if docker ps -q --filter "label=${LABEL_NS}.managed=true" --filter "name=^${target}$" | grep -q .; then
        echo "$target"
        return 0
    fi

    # Substring match on name or workspace label
    local matches=() id name workspace
    for id in $(list_sandbox_ids); do
        name=$(docker inspect --format '{{.Name}}' "$id" | sed 's|^/||')
        workspace=$(docker inspect --format "{{index .Config.Labels \"${LABEL_NS}.workspace\"}}" "$id" 2>/dev/null || echo "")
        if [[ "$name" == *"$target"* || "$workspace" == *"$target"* ]]; then
            matches+=("$name")
        fi
    done

    if [[ ${#matches[@]} -eq 0 ]]; then
        say_err "No matching sandbox for: ${target}"
        return 1
    elif [[ ${#matches[@]} -eq 1 ]]; then
        echo "${matches[0]}"
        return 0
    fi
    printf '%s\n' "${matches[@]}" | gum choose --header "'${target}' matches multiple — pick one" --height=10
}

