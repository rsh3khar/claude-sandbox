# Build the full `docker run` argv into DOCKER_ARGS. Kept separate from
# execution so --dry-run and the tests can inspect it.
DOCKER_ARGS=()

build_docker_args() {
    DOCKER_ARGS=(run --rm -it --init)

    CONTAINER_NAME="${CONTAINER_NAME:-$(generate_container_name)}"
    DOCKER_ARGS+=(--name "$CONTAINER_NAME")

    # Labels drive `cs ps` / `cs attach` / `cs kill`
    DOCKER_ARGS+=(
        --label "${LABEL_NS}.managed=true"
        --label "${LABEL_NS}.version=${VERSION}"
        --label "${LABEL_NS}.repo=${SELECTED_REPO}"
    )
    if [[ "$LOCAL_MODE" == true ]]; then
        DOCKER_ARGS+=(--label "${LABEL_NS}.workspace=${LOCAL_PATH}")
        DOCKER_ARGS+=(--label "${LABEL_NS}.mode=local")
    else
        DOCKER_ARGS+=(--label "${LABEL_NS}.mode=github")
    fi

    if [[ "$NETWORK" == "host" ]]; then
        DOCKER_ARGS+=(--network host)
    else
        DOCKER_ARGS+=(--network "$NETWORK")
        for p in ${PUBLISH_PORTS[@]+"${PUBLISH_PORTS[@]}"}; do
            DOCKER_ARGS+=(-p "$p")
        done
    fi

    DOCKER_ARGS+=(-e "TERM=${TERM:-xterm-256color}" -e "CLAUDE_SANDBOX=1")

    # Git identity from host
    local git_name git_email
    git_name=$(git config --global user.name 2>/dev/null || echo "")
    git_email=$(git config --global user.email 2>/dev/null || echo "")
    DOCKER_ARGS+=(-e "GIT_USER_NAME=$git_name" -e "GIT_USER_EMAIL=$git_email")

    # SSH agent forwarding — socket location differs per Docker runtime
    if [[ -S "/run/host-services/ssh-auth.sock" ]]; then
        DOCKER_ARGS+=(
            -v "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
            -e "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"
        )
    elif [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
        DOCKER_ARGS+=(
            -v "$SSH_AUTH_SOCK:/tmp/ssh-agent.sock"
            -e "SSH_AUTH_SOCK=/tmp/ssh-agent.sock"
        )
    fi

    # Host config mounts (each guarded — only mounted if present)
    [[ -d "$HOME/.claude" ]]     && DOCKER_ARGS+=(-v "$HOME/.claude:/home/node/.claude")
    [[ -d "$HOME/.ssh" ]]        && DOCKER_ARGS+=(-v "$HOME/.ssh:/home/node/.ssh-host:ro")
    [[ -d "$HOME/.aws" ]]        && DOCKER_ARGS+=(-v "$HOME/.aws:/home/node/.aws")
    [[ -d "$HOME/.config/gh" ]]  && DOCKER_ARGS+=(-v "$HOME/.config/gh:/home/node/.config/gh:ro")
    [[ -d "$HOME/.codex" ]]      && DOCKER_ARGS+=(-v "$HOME/.codex:/home/node/.codex")
    [[ -d "$HOME/.agents" ]]     && DOCKER_ARGS+=(-v "$HOME/.agents:/home/node/.agents")

    # AWS env passthrough
    [[ -n "${AWS_PROFILE:-}" ]]        && DOCKER_ARGS+=(-e "AWS_PROFILE=$AWS_PROFILE")
    [[ -n "${AWS_DEFAULT_REGION:-}" ]] && DOCKER_ARGS+=(-e "AWS_DEFAULT_REGION=$AWS_DEFAULT_REGION")
    [[ -n "${AWS_REGION:-}" ]]         && DOCKER_ARGS+=(-e "AWS_REGION=$AWS_REGION")

    # Feature toggles
    [[ "$AUTO_GIT" == false ]]    && DOCKER_ARGS+=(-e "DISABLE_AUTO_GIT=1")
    [[ "$AUTO_GIT" == true ]]     && DOCKER_ARGS+=(-e "AUTO_GIT_INTERVAL=$AUTO_GIT_INTERVAL")
    [[ "$UPDATE_TOOLS" == true ]] && DOCKER_ARGS+=(-e "UPDATE_TOOLS=1")
    [[ -n "$SANDBOX_BRANCH" ]]    && DOCKER_ARGS+=(-e "SANDBOX_BRANCH=$SANDBOX_BRANCH")
    [[ "$ASSUME_YES" == true && -z "$SANDBOX_BRANCH" ]] && DOCKER_ARGS+=(-e "SKIP_BRANCH_MENU=1")

    if [[ "$BROWSER" == true ]]; then
        DOCKER_ARGS+=(
            --shm-size=256m
            -e "ENABLE_BROWSER=1"
            -v "${BROWSER_VOLUME}:/usr/local/share/playwright"
        )
    fi

    # Auth (never echoed back to the terminal)
    local oauth_token="${CLAUDE_CODE_OAUTH_TOKEN:-}"
    if [[ -z "$oauth_token" && -f "$HOME/.claude-sandbox-token" ]]; then
        oauth_token=$(tr -d '\n' < "$HOME/.claude-sandbox-token" 2>/dev/null || echo "")
    fi
    if [[ -n "$oauth_token" ]]; then
        DOCKER_ARGS+=(-e "CLAUDE_CODE_OAUTH_TOKEN=$oauth_token")
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        DOCKER_ARGS+=(-e "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
    fi

    local gh_token
    gh_token=$(gh auth token 2>/dev/null | tr -d '\n' || echo "")
    [[ -n "$gh_token" ]] && DOCKER_ARGS+=(-e "GH_TOKEN=$gh_token")

    # Workspace mounts + entrypoint args
    if [[ "$LOCAL_MODE" == true ]]; then
        DOCKER_ARGS+=(-e "LOCAL_MODE=1")
        DOCKER_ARGS+=(-v "$LOCAL_PATH:/home/node/workspace/$SELECTED_REPO")
        for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
            DOCKER_ARGS+=(-v "${ep%%:*}:/home/node/workspace/${ep##*:}")
        done
        DOCKER_ARGS+=("$IMAGE_REF" "--local" "$SELECTED_REPO")
    else
        DOCKER_ARGS+=("$IMAGE_REF" "$SELECTED_REPO_URL")
    fi
}

# Print the docker command with secrets masked
print_docker_command() {
    local out="docker" arg
    for arg in "${DOCKER_ARGS[@]}"; do
        case "$arg" in
            CLAUDE_CODE_OAUTH_TOKEN=*) arg="CLAUDE_CODE_OAUTH_TOKEN=***" ;;
            ANTHROPIC_API_KEY=*)       arg="ANTHROPIC_API_KEY=***" ;;
            GH_TOKEN=*)                arg="GH_TOKEN=***" ;;
        esac
        if [[ "$arg" =~ [[:space:]] ]]; then
            out+=" '$arg'"
        else
            out+=" $arg"
        fi
    done
    echo "$out"
}

report_launch_context() {
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" || -f "$HOME/.claude-sandbox-token" ]]; then
        say_ok "Using OAuth token"
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        say_ok "Using API key"
    else
        say_warn "${C_DIM}No auth — run 'claude setup-token' and save to ~/.claude-sandbox-token${NC}"
    fi

    if [[ -d "$HOME/.aws" ]]; then
        if aws sts get-caller-identity &>/dev/null; then
            say_ok "AWS credentials mounted (live session)"
        else
            say_warn "${C_DIM}AWS config mounted (no active session — run ${C_TEXT}aws sso login${C_DIM} on host)${NC}"
        fi
    fi

    if gh auth token &>/dev/null; then
        say_ok "GitHub CLI token forwarded"
    elif [[ -d "$HOME/.config/gh" ]]; then
        say_warn "${C_DIM}GitHub config mounted (token in keyring not accessible)${NC}"
    fi

    [[ "$AUTO_GIT" == true ]] && say_ok "Auto-save enabled" || say_warn "Auto-save disabled"
    [[ "$BROWSER" == true ]] && say_ok "Headless browser enabled" || say_dim "Browser disabled"
    [[ "$UPDATE_TOOLS" == true ]] && say_ok "Will update tools on start"

    if [[ "$LOCAL_MODE" == true ]]; then
        say_ok "Local mode: mounting ${LOCAL_PATH}"
        for ep in ${EXTRA_PATHS[@]+"${EXTRA_PATHS[@]}"}; do
            say_ok "Extra mount: ${ep##*:}"
        done
    fi
}

launch_sandbox() {
    if [[ "$DRY_RUN" != true ]]; then
        clear
        echo ""
        draw_mini_logo
        echo ""
        echo -e "  ${C_ACCENT}▸${NC} Preparing sandbox..."
    fi

    resolve_image
    build_docker_args

    if [[ "$DRY_RUN" == true ]]; then
        print_docker_command
        return 0
    fi

    report_launch_context

    echo -e "  ${C_ACCENT}▸${NC} Launching ${C_ACCENT}${CONTAINER_NAME}${NC}..."
    echo ""

    docker "${DOCKER_ARGS[@]}"

    echo ""
    say_ok "${C_TEXT}Container destroyed${NC}"
    if [[ "$LOCAL_MODE" == true ]]; then
        echo -e "  ${C_DIM}  Your changes are on a local branch${NC}"
    else
        echo -e "  ${C_DIM}  Your changes are safely on GitHub${NC}"
    fi
    echo ""
}

