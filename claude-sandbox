draw_box() {
    local width=$1 title="${2:-}"
    local inner=$((width - 2))

    if [[ -n "$title" ]]; then
        local title_len=${#title}
        local left_pad=$(( (inner - title_len - 2) / 2 ))
        local right_pad=$(( inner - title_len - 2 - left_pad ))
        echo -e "${C_BORDER}${TL}$(printf '%*s' "$left_pad" '' | tr ' ' "$H") ${C_ACCENT}${title}${C_BORDER} $(printf '%*s' "$right_pad" '' | tr ' ' "$H")${TR}${NC}"
    else
        echo -e "${C_BORDER}${TL}$(printf '%*s' "$inner" '' | tr ' ' "$H")${TR}${NC}"
    fi
}

draw_box_bottom() {
    local width=$1
    local inner=$((width - 2))
    echo -e "${C_BORDER}${BL}$(printf '%*s' "$inner" '' | tr ' ' "$H")${BR}${NC}"
}

draw_box_row() {
    local width=$1 content="$2"
    local inner=$((width - 4))
    # Strip ANSI codes and count visible characters properly
    local stripped
    stripped=$(echo -e "$content" | sed $'s/\x1b\\[[0-9;]*m//g')
    local text_len=${#stripped}
    local padding=$((inner - text_len))
    [[ $padding -lt 0 ]] && padding=0

    echo -e "${C_BORDER}${V}${NC} ${content}$(printf '%*s' "$padding" '') ${C_BORDER}${V}${NC}"
}

draw_spacer() {
    local width=$1
    local inner=$((width - 4))
    echo -e "${C_BORDER}${V}${NC}$(printf '%*s' "$((inner + 2))" '')${C_BORDER}${V}${NC}"
}

draw_separator() {
    local width=$1
    local inner=$((width - 2))
    echo -e "${C_BORDER}├$(printf '%*s' "$inner" '' | tr ' ' '─')┤${NC}"
}

