screen_local_path() {
    local w=56

    clear
    echo ""
    draw_mini_logo
    echo ""

    draw_box $w "LOCAL REPOSITORY"
    draw_spacer $w
    draw_box_row $w "${C_DIM}  Enter path to a git repository${NC}"
    draw_box_row $w "${C_DIM}  Use ${C_TEXT}.${C_DIM} for current directory${NC}"
    draw_spacer $w
    draw_box_bottom $w
    echo ""

    local path_input
    path_input=$(gum input --placeholder="." --value=".")

    if [[ -z "$path_input" ]]; then
        path_input="."
    fi

    # Expand ~ and resolve to absolute path
    path_input="${path_input/#\~/$HOME}"
    LOCAL_PATH=$(cd "$path_input" 2>/dev/null && pwd) || {
        echo ""
        echo -e "  ${C_ERROR}${CROSS}${NC} Directory not found: ${path_input}"
        sleep 2
        LOCAL_MODE=false
        return
    }

    # Check if it's a git repo
    if [[ ! -d "$LOCAL_PATH/.git" ]]; then
        echo ""
        echo -e "  ${C_ERROR}${CROSS}${NC} Not a git repository: ${LOCAL_PATH}"
        sleep 2
        LOCAL_MODE=false
        return
    fi

    # Get repo name from directory
    SELECTED_REPO=$(basename "$LOCAL_PATH")

    echo ""
    echo -e "  ${C_SUCCESS}${CHECK}${NC} Found git repo: ${C_ACCENT}${SELECTED_REPO}${NC}"
    sleep 1

    # Offer to mount additional directories
    EXTRA_PATHS=()
    while true; do
        echo ""
        if ! gum confirm "Mount additional directories?"; then
            break
        fi

        local extra_input
        extra_input=$(gum input --placeholder="Path to another git repo...")

        if [[ -z "$extra_input" ]]; then
            break
        fi

        validate_and_add_extra_path "$extra_input" || sleep 1
    done
}

